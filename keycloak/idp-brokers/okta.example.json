{
  "_comment": "Okta OIDC broker template. Security & Access Mesh spec Part 2.1. Provision per-tenant via: scripts/setup-keycloak-realm.sh --idp-config /path/to/okta.json. Cardinal Rule 1.3: clientId / clientSecret placeholders are filled in at provisioning time from a secrets manager.",

  "alias": "okta-tenant-example",
  "displayName": "Okta (Example Tenant)",
  "providerId": "oidc",
  "enabled": true,
  "updateProfileFirstLoginMode": "on",
  "trustEmail": true,
  "storeToken": false,
  "linkOnly": false,
  "config": {
    "clientId": "<OKTA_CLIENT_ID>",
    "clientSecret": "<OKTA_CLIENT_SECRET>",
    "discoveryEndpoint": "https://<OKTA_DOMAIN>/.well-known/openid-configuration",
    "authorizationUrl": "https://<OKTA_DOMAIN>/oauth2/v1/authorize",
    "tokenUrl": "https://<OKTA_DOMAIN>/oauth2/v1/token",
    "userInfoUrl": "https://<OKTA_DOMAIN>/oauth2/v1/userinfo",
    "defaultScope": "openid profile email groups",
    "validateSignature": "true",
    "useJwksUrl": "true",
    "jwksUrl": "https://<OKTA_DOMAIN>/oauth2/v1/keys",
    "prompt": "login"
  },
  "mappers": [
    {
      "_comment": "Pass through Okta group Object IDs verbatim — Cardinal Rule 7.4.",
      "name": "okta-groups-pass-through",
      "identityProviderMapper": "oidc-group-membership-mapper",
      "config": {
        "claim": "groups",
        "full.path": "false",
        "multivalued": "true"
      }
    },
    {
      "name": "okta-email",
      "identityProviderMapper": "oidc-user-attribute-mapper",
      "config": {
        "claim": "email",
        "user.attribute": "email"
      }
    }
  ]
}