{
  "_comment": "Ping Identity SAML broker template. Security & Access Mesh spec Part 2.1. Provision per-tenant via: scripts/setup-keycloak-realm.sh --idp-config /path/to/ping.json. Cardinal Rule 1.3: SAML metadata XML is filled in at provisioning time from a secrets manager.",

  "alias": "ping-tenant-example",
  "displayName": "Ping Identity (Example Tenant)",
  "providerId": "saml",
  "enabled": true,
  "updateProfileFirstLoginMode": "on",
  "trustEmail": true,
  "storeToken": false,
  "linkOnly": false,
  "config": {
    "entityId": "https://<PING_ENTITY_ID>",
    "singleSignOnServiceUrl": "https://<PING_SSO_URL>/idp/SSO.saml2",
    "singleLogoutServiceUrl": "https://<PING_SLO_URL>/idp/SLO.saml2",
    "nameIDPolicyFormat": "urn:oasis:names:tc:SAML:1.1:nameid-format:emailAddress",
    "signingCertificate": "<PING_SIGNING_CERTIFICATE_PEM>",
    "signatureAlgorithm": "RSA_SHA256",
    "canonicalizationMethod": "EXCLUSIVE",
    "forceAuthn": "false",
    "postBindingResponse": "true",
    "postBindingAuthnRequest": "true",
    "wantAssertionsSigned": "true",
    "wantAssertionsEncrypted": "false",
    "allowedClockSkew": "30"
  },
  "mappers": [
    {
      "_comment": "SAML attribute statement → Keycloak group claim. Cardinal Rule 7.4: pass the raw external group identifier (e.g., Ping group GUID) verbatim — do NOT translate to a Keycloak role.",
      "name": "ping-groups-attribute",
      "identityProviderMapper": "saml-user-attribute-idp-mapper",
      "config": {
        "user.attribute": "groups",
        "attribute.name": "http://schemas.xmlsoap.org/claims/Group",
        "attribute.friendly.name": "groups",
        "multivalued": "true"
      }
    },
    {
      "name": "ping-email",
      "identityProviderMapper": "saml-user-attribute-idp-mapper",
      "config": {
        "user.attribute": "email",
        "attribute.name": "email",
        "attribute.friendly.name": "email"
      }
    }
  ]
}