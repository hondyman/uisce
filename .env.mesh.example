# =============================================================================
# Mesh Connection Configuration
# =============================================================================
# Copy this file to .env.mesh in the project root and set MESH_HOST.
# DO NOT commit .env.mesh to version control — it is gitignored.
#
#   cp .env.mesh.example .env.mesh
#   # edit MESH_HOST
#   source scripts/connect-to-mesh.sh --verify
# =============================================================================

# Required: IP address of the Linux box running docker-compose.production.yml
MESH_HOST=192.168.1.100

# Optional overrides — defaults match docker-compose.production.yml
# MESH_USER=uisce
# MESH_PASSWORD=uisce_admin_password_localdev
# MESH_DB=uisce_control_plane
# MESH_DB_PORT=5432
# MESH_REDIS_PORT=6379
# MESH_KAFKA_PORT=9092
# MESH_STARROCKS_PORT=9030
# MESH_BACKEND_PORT=8080
