# Infisical Configuration
# Copy this file to .env.infisical and fill in your values
# IMPORTANT: Never commit .env.infisical to version control!

# Self-hosted Infisical instance
INFISICAL_DOMAIN=http://100.84.50.65:8085

# Service token from Infisical dashboard (Project Settings > Service Tokens)
INFISICAL_TOKEN=st.your-service-token-here

# Project ID (found in Project Settings)
INFISICAL_PROJECT_ID=9af25976-bafc-4895-a057-2effec13c620

# Environment: dev, staging, prod
INFISICAL_ENVIRONMENT=dev
