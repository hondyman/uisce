new file mode 100644
index 000000000..f91da8e9a
--- /dev/null
+++ b/frontend/scripts/fix_mui_v7_grid.py
@@ -0,0 +1,111 @@
+#!/usr/bin/env python3
+"""
+Fix MUI v7 Grid item/xs props.
+MUI v7: <Grid item xs={N} md={M}> → <Grid size={{ xs: N, md: M }}>
+"""
+
+import re
+import sys
+from pathlib import Path
+
+
+def fix_grid_tag(tag: str) -> tuple[str, int]:
+    m = re.match(r'(<Grid)(\s*[^>]*?)(>.*)$', tag, re.DOTALL)
+    if not m:
+        return tag, 0
+
+    open_part = m.group(1)
+    inner = m.group(2)
+    rest = m.group(3)
+
+    if 'item' not in inner:
+        return tag, 0
+
+    bp_keys = ['xs', 'sm', 'md', 'lg', 'xl']
+    bp_values = {}
+    remaining = inner
+
+    for key in bp_keys:
+        pattern = rf'{key}\s*=\s*\{{([^}}]+)\}}'
+        match = re.search(pattern, remaining)
+        if match:
+            bp_values[key] = match.group(1).strip()
+            remaining = re.sub(pattern, '', remaining)
+
+    if not bp_values:
+        return tag, 0
+
+    remaining = re.sub(r'\s*item\s*', ' ', remaining)
+    remaining = remaining.strip()
+
+    size_str = ', '.join(f'{k}: {v}' for k, v in bp_values.items())
+    size_attr = f' size={{{{ {size_str} }}}}'
+
+    if remaining:
+        new_tag = f'{open_part} {remaining}{size_attr}{rest}'
+    else:
+        new_tag = f'{open_part}{size_attr.rstrip()}{rest}'
+
+    return new_tag, 1
+
+
+def fix_grid_item(content: str) -> tuple[str, int]:
+    changes = 0
+    i = 0
+    while i < len(content):
+        idx = content.find('<Grid', i)
+        if idx == -1:
+            break
+        depth = 0
+        j = idx + 5
+        while j < len(content):
+            c = content[j]
+            if c == '{':
+                depth += 1
+            elif c == '}':
+                depth -= 1
+            elif c == '>' and depth == 0:
+                break
+            j += 1
+        else:
+            i = idx + 1
+            continue
+
+        tag = content[idx:j+1]
+        if 'item' in tag:
+            new_tag, n = fix_grid_tag(tag)
+            if n > 0:
+                content = content[:idx] + new_tag + content[j+1:]
+                changes += n
+                i = idx + len(new_tag)
+            else:
+                i = j + 1
+        else:
+            i = j + 1
+
+    return content, changes
+
+
+def process_file(filepath: str, dry_run: bool = False) -> int:
+    path = Path(filepath)
+    if not path.exists():
+        return 0
+    original = path.read_text(encoding='utf-8')
+    new_content, changes = fix_grid_item(original)
+    if changes > 0 and not dry_run:
+        path.write_text(new_content, encoding='utf-8')
+        print(f"  [FIXED] {changes} Grid props in {filepath}")
+    elif changes > 0:
+        print(f"  [DRY] {changes} Grid props in {filepath}")
+    return changes
+
+
+def main():
+    dry_run = '--dry-run' in sys.argv
+    if dry_run:
+        sys.argv.remove('--dry-run')
+    files = sys.argv[1:]
+    if not files:
+        files = [str(p) for p in Path('src').rglob('*.tsx')]
