new file mode 100644
index 000000000..122b09cd8
--- /dev/null
+++ b/backend/internal/handlers/vocabulary_resolve_handler.go
@@ -0,0 +1,108 @@
+package handlers
+
+import (
+	"encoding/json"
+	"net/http"
+	"strings"
+
+	"github.com/go-chi/chi/v5"
+	jwtmiddleware "github.com/hondyman/uisce/libs/jwt-middleware"
+)
+
+type VocabularyResolveHandler struct{}
+
+func NewVocabularyResolveHandler() *VocabularyResolveHandler {
+	return &VocabularyResolveHandler{}
+}
+
+type ResolvedTerm struct {
+	Token       string `json:"token"`
+	BOSemantic  string `json:"bo_semantic"`
+	BOKey       string `json:"bo_key"`
+	FieldName   string `json:"field_name,omitempty"`
+	ColumnName  string `json:"column_name,omitempty"`
+	TableName   string `json:"table_name,omitempty"`
+	Confidence  float64 `json:"confidence"`
+}
+
+type VocabularyResolveResponse struct {
+	ResolvedTerms []ResolvedTerm `json:"resolved_terms"`
+	Unresolved   []string       `json:"unresolved_tokens"`
+}
+
+var tokenBOMap = map[string]struct {
+	boKey      string
+	boSemantic string
+	confidence float64
+}{
+	"customer":     {boKey: "bo_customer", boSemantic: "Customer", confidence: 0.98},
+	"customers":   {boKey: "bo_customer", boSemantic: "Customer", confidence: 0.97},
+	"order":       {boKey: "bo_order", boSemantic: "Order", confidence: 0.95},
+	"orders":      {boKey: "bo_order", boSemantic: "Order", confidence: 0.94},
+	"product":     {boKey: "bo_product", boSemantic: "Product", confidence: 0.93},
+	"products":    {boKey: "bo_product", boSemantic: "Product", confidence: 0.92},
+	"trades":      {boKey: "bo_trade", boSemantic: "Trade", confidence: 0.91},
+	"trade":       {boKey: "bo_trade", boSemantic: "Trade", confidence: 0.90},
+	"account":     {boKey: "bo_account", boSemantic: "Account", confidence: 0.89},
+	"accounts":    {boKey: "bo_account", boSemantic: "Account", confidence: 0.88},
+	"invoice":     {boKey: "bo_invoice", boSemantic: "Invoice", confidence: 0.87},
+	"invoices":    {boKey: "bo_invoice", boSemantic: "Invoice", confidence: 0.86},
+	"supplier":    {boKey: "bo_supplier", boSemantic: "Supplier", confidence: 0.85},
+	"suppliers":   {boKey: "bo_supplier", boSemantic: "Supplier", confidence: 0.84},
+	"employee":    {boKey: "bo_employee", boSemantic: "Employee", confidence: 0.83},
+	"employees":   {boKey: "bo_employee", boSemantic: "Employee", confidence: 0.82},
+	"sales":      {boKey: "bo_order", boSemantic: "Sales Order", confidence: 0.80},
+	"revenue":    {boKey: "bo_order", boSemantic: "Revenue", confidence: 0.79},
+	"freight":    {boKey: "bo_order", boSemantic: "Freight", confidence: 0.78},
+	"discount":   {boKey: "bo_order_line", boSemantic: "Discount", confidence: 0.77},
+	"shipment":   {boKey: "bo_order", boSemantic: "Shipment", confidence: 0.76},
+}
+
+func (h *VocabularyResolveHandler) RegisterRoutes(r chi.Router) {
+	r.Route("/api/v1/vocabulary", func(sub chi.Router) {
+		sub.Get("/resolve", h.ResolveTokens)
+	})
+}
+
+func (h *VocabularyResolveHandler) ResolveTokens(w http.ResponseWriter, r *http.Request) {
+	claims := jwtmiddleware.GetClaimsFromContext(r)
+	if claims == nil || claims.TenantID == "" {
+		http.Error(w, "unauthorized", http.StatusUnauthorized)
+		return
+	}
+
+	tokensParam := r.URL.Query().Get("tokens")
+	if tokensParam == "" {
+		w.Header().Set("Content-Type", "application/json")
+		json.NewEncoder(w).Encode(VocabularyResolveResponse{ResolvedTerms: []ResolvedTerm{}, Unresolved: []string{}})
+		return
+	}
+
+	tokens := strings.Split(strings.ToLower(tokensParam), ",")
+	resolvedTerms := []ResolvedTerm{}
+	unresolved := []string{}
+
+	for _, token := range tokens {
+		token = strings.TrimSpace(token)
+		if token == "" {
+			continue
+		}
+
+		if mapping, ok := tokenBOMap[token]; ok {
+			resolvedTerms = append(resolvedTerms, ResolvedTerm{
+				Token:      token,
+				BOSemantic: mapping.boSemantic,
+				BOKey:      mapping.boKey,
+				Confidence: mapping.confidence,
+			})
+		} else {
+			unresolved = append(unresolved, token)
+		}
+	}
+
+	w.Header().Set("Content-Type", "application/json")
+	json.NewEncoder(w).Encode(VocabularyResolveResponse{
+		ResolvedTerms: resolvedTerms,
+		Unresolved:    unresolved,
+	})
+}
