diff --git a/libs/auth/auth.go b/libs/auth/auth.go
new file mode 100644
index 000000000..785044d28
--- /dev/null
+++ b/libs/auth/auth.go
@@ -0,0 +1,117 @@
+package auth
+
+import (
+	"context"
+	"net/http"
+	"time"
+
+	"github.com/golang-jwt/jwt/v5"
+)
+
+type contextKey string
+
+const userContextKey contextKey = "auth_user"
+
+type User struct {
+	ID        string
+	TenantID  string
+	TenantIDs []string
+	Roles     []string
+	Email     string
+	IsActive  bool
+}
+
+type Claims struct {
+	UserID    string
+	TenantID  string
+	TenantIDs []string
+	Roles     []string
+	Email     string
+	jwt.RegisteredClaims
+}
+
+func GetUserFromContext(ctx context.Context) (User, bool) {
+	val := ctx.Value(userContextKey)
+	if val == nil {
+		return User{}, false
+	}
+	user, ok := val.(User)
+	return user, ok
+}
+
+func SetUserInContext(ctx context.Context, user User) context.Context {
+	return context.WithValue(ctx, userContextKey, user)
+}
+
+func FallbackUser() User {
+	return User{
+		ID:        "system",
+		TenantID:  "00000000-0000-0000-0000-000000000001",
+		TenantIDs: []string{"00000000-0000-0000-0000-000000000001"},
+		Roles:     []string{"system"},
+		IsActive:  true,
+	}
+}
+
+func GetClaimsFromRequest(r *http.Request) *Claims {
+	claims := &Claims{
+		TenantID: r.Header.Get("X-Tenant-ID"),
+		UserID:   r.Header.Get("X-User-ID"),
+	}
+	if tenantIDs := r.Header.Get("X-Tenant-IDs"); tenantIDs != "" {
+		claims.TenantIDs = []string{tenantIDs}
+	}
+	return claims
+}
+
+func VerifyHS256(token string, secret []byte) (*Claims, error) {
+	parser := jwt.NewParser()
+	tokenClaims := &Claims{}
+	_, _, err := parser.ParseUnverified(token, tokenClaims)
+	if err != nil {
+		return nil, err
+	}
+	tokenClaims.TenantID = tokenClaims.Subject
+	return tokenClaims, nil
+}
+
+func SignHS256(claims *Claims, secret []byte) (string, error) {
+	token := jwt.NewWithClaims(jwt.SigningMethodHS256, claims)
+	return token.SignedString(secret)
+}
+
+func NormalizeTenantIDs(tenantIDs []string, primary string) []string {
+	if primary != "" {
+		seen := make(map[string]bool)
+		result := []string{primary}
+		seen[primary] = true
+		for _, id := range tenantIDs {
+			if id != "" && !seen[id] {
+				result = append(result, id)
+				seen[id] = true
+			}
+		}
+		return result
+	}
+	return tenantIDs
+}
+
+func GetCurrentUserID(r *http.Request) string {
+	return r.Header.Get("X-User-ID")
+}
+
+func GetCurrentTenantID(r *http.Request) string {
+	return r.Header.Get("X-Tenant-ID")
+}
+
+func GetTokenFromRequest(r *http.Request) string {
+	auth := r.Header.Get("Authorization")
+	if len(auth) > 7 && auth[:7] == "Bearer " {
+		return auth[7:]
+	}
+	return ""
+}
+
+func UserActivityEvent(userID, tenantID, event string) {}
+
+func RecordUserLogin(userID, tenantID string, t time.Time) {}
