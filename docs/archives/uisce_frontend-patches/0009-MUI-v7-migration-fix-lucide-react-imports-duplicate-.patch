diff --git a/backend/internal/handlers/explicit_feedback_handler.go b/backend/internal/handlers/explicit_feedback_handler.go
new file mode 100644
index 000000000..1dc5784d8
--- /dev/null
+++ b/backend/internal/handlers/explicit_feedback_handler.go
@@ -0,0 +1,130 @@
+package handlers
+
+import (
+	"encoding/json"
+	"net/http"
+
+	"github.com/go-chi/chi/v5"
+	"github.com/google/uuid"
+	"github.com/hondyman/uisce/backend/internal/ai"
+	jwtmiddleware "github.com/hondyman/uisce/libs/jwt-middleware"
+)
+
+var validRatingTypes = map[string]bool{
+	"THUMBS_UP":  true,
+	"THUMBS_DOWN": true,
+	"CLICKED":     true,
+	"DISMISSED":   true,
+	"ADOPTED":     true,
+}
+
+var validErrorCategories = map[string]bool{
+	"WRONG_TABLE":          true,
+	"INCORRECT_FORMULA":     true,
+	"MISSING_DATA":          true,
+	"HALLUCINATED_SCHEMA":  true,
+	"NONE":                 true,
+}
+
+type ExplicitFeedbackHandler struct {
+	feedbackProcessor *ai.FeedbackProcessor
+}
+
+func NewExplicitFeedbackHandler(processor *ai.FeedbackProcessor) *ExplicitFeedbackHandler {
+	return &ExplicitFeedbackHandler{feedbackProcessor: processor}
+}
+
+type ExplicitFeedbackPayload struct {
+	TargetBOKey         string `json:"target_bo_key"`
+	RatingType          string `json:"rating_type"`
+	StarScore           int    `json:"star_score"`
+	ErrorCategory       string `json:"error_category"`
+	UserComment         string `json:"user_comment,omitempty"`
+	RecommendationLabel string `json:"recommendation_label,omitempty"`
+	SessionHash         string `json:"session_hash,omitempty"`
+}
+
+func (h *ExplicitFeedbackHandler) RegisterRoutes(r chi.Router) {
+	r.Route("/api/v1/ai", func(sub chi.Router) {
+		sub.Post("/feedback/explicit", h.SubmitExplicitFeedback)
+	})
+}
+
+func (h *ExplicitFeedbackHandler) SubmitExplicitFeedback(w http.ResponseWriter, r *http.Request) {
+	claims := jwtmiddleware.GetClaimsFromContext(r)
+	if claims == nil {
+		http.Error(w, "unauthorized", http.StatusUnauthorized)
+		return
+	}
+	if claims.TenantID == "" || claims.UserID == "" {
+		http.Error(w, "missing tenant or user identity", http.StatusUnauthorized)
+		return
+	}
+
+	var payload ExplicitFeedbackPayload
+	if err := json.NewDecoder(r.Body).Decode(&payload); err != nil {
+		http.Error(w, "invalid request body: "+err.Error(), http.StatusBadRequest)
+		return
+	}
+
+	if !validRatingTypes[payload.RatingType] {
+		http.Error(w, "invalid rating_type: must be THUMBS_UP, THUMBS_DOWN, CLICKED, DISMISSED, or ADOPTED", http.StatusBadRequest)
+		return
+	}
+	if !validErrorCategories[payload.ErrorCategory] {
+		http.Error(w, "invalid error_category: must be WRONG_TABLE, INCORRECT_FORMULA, MISSING_DATA, HALLUCINATED_SCHEMA, or NONE", http.StatusBadRequest)
+		return
+	}
+
+	starScore := payload.StarScore
+	if starScore == 0 {
+		if payload.RatingType == "THUMBS_UP" || payload.RatingType == "ADOPTED" || payload.RatingType == "CLICKED" {
+			starScore = 5
+		} else {
+			starScore = 1
+		}
+	}
+
+	var correction map[string]interface{}
+	if payload.ErrorCategory != "" && payload.ErrorCategory != "NONE" {
+		correction = map[string]interface{}{
+			"error_category":        payload.ErrorCategory,
+			"recommendation_label":  payload.RecommendationLabel,
+			"user_comment":          payload.UserComment,
+			"target_bo_key":         payload.TargetBOKey,
+		}
+	} else {
+		correction = map[string]interface{}{
+			"rating_type":           payload.RatingType,
+			"recommendation_label":   payload.RecommendationLabel,
+			"target_bo_key":          payload.TargetBOKey,
+		}
+	}
+
+	tenantID, _ := uuid.Parse(claims.TenantID)
+	createdBy, _ := uuid.Parse(claims.UserID)
+
+	feedback := ai.UserFeedback{
+		TenantID:   tenantID,
+		CreatedBy:  createdBy,
+		Confidence: starScore,
+		Correction: correction,
+		Comments:   payload.UserComment,
+	}
+
+	resp, err := h.feedbackProcessor.ProcessFeedback(r.Context(), feedback)
+	if err != nil {
+		http.Error(w, "feedback processing failed: "+err.Error(), http.StatusInternalServerError)
+		return
+	}
+
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(http.StatusOK)
+	json.NewEncoder(w).Encode(map[string]interface{}{
+		"success":            true,
+		"feedback_id":       resp.FeedbackID,
+		"improvement_impact": resp.ImprovementImpact,
+		"retraining_queued":  resp.RetrainingQueued,
+		"next_steps":         resp.NextSteps,
+	})
+}
diff --git a/backend/internal/handlers/history_handler.go b/backend/internal/handlers/history_handler.go
new file mode 100644
index 000000000..e6e453304
--- /dev/null
+++ b/backend/internal/handlers/history_handler.go
@@ -0,0 +1,89 @@
+package handlers
+
+import (
+	"encoding/json"
+	"net/http"
+	"strconv"
+
+	"github.com/go-chi/chi/v5"
+	"github.com/jmoiron/sqlx"
+	jwtmiddleware "github.com/hondyman/uisce/libs/jwt-middleware"
+)
+
+type InteractionHistoryHandler struct {
+	db *sqlx.DB
+}
+
+func NewInteractionHistoryHandler(db *sqlx.DB) *InteractionHistoryHandler {
+	return &InteractionHistoryHandler{db: db}
+}
+
+type InteractionHistoryItem struct {
+	InteractionID string `json:"interaction_id"`
+	PromptText    string `json:"prompt_text"`
+	IntentCategory string `json:"intent_category"`
+	ReferencedBOs  []string `json:"referenced_bo_keys"`
+	CreatedAt     string `json:"created_at"`
+}
+
+func (h *InteractionHistoryHandler) RegisterRoutes(r chi.Router) {
+	r.Route("/api/v1/ai", func(sub chi.Router) {
+		sub.Get("/history", h.GetHistory)
+	})
+}
+
+func (h *InteractionHistoryHandler) GetHistory(w http.ResponseWriter, r *http.Request) {
+	claims := jwtmiddleware.GetClaimsFromContext(r)
+	if claims == nil || claims.TenantID == "" {
+		http.Error(w, "unauthorized", http.StatusUnauthorized)
+		return
+	}
+
+	limitStr := r.URL.Query().Get("limit")
+	limit := 5
+	if l, err := strconv.Atoi(limitStr); err == nil && l > 0 && l <= 20 {
+		limit = l
+	}
+
+	query := `
+		SELECT
+			interaction_id::text,
+			prompt_raw_scrubbed AS prompt_text,
+			intent_category,
+			referenced_bo_keys,
+			created_at::text AS created_at
+		FROM ai_interaction_log
+		WHERE tenant_id = $1
+		ORDER BY created_at DESC
+		LIMIT $2
+	`
+
+	rows, err := h.db.QueryxContext(r.Context(), query, claims.TenantID, limit)
+	if err != nil {
+		w.Header().Set("Content-Type", "application/json")
+		json.NewEncoder(w).Encode(map[string]interface{}{
+			"interactions": []interface{}{},
+			"note":        "ai_interaction_log not available in this deployment",
+		})
+		return
+	}
+	defer rows.Close()
+
+	interactions := []InteractionHistoryItem{}
+	for rows.Next() {
+		var item InteractionHistoryItem
+		var boKeysJSON []byte
+		if err := rows.Scan(&item.InteractionID, &item.PromptText, &item.IntentCategory, &boKeysJSON, &item.CreatedAt); err != nil {
+			continue
+		}
+		if len(boKeysJSON) > 0 {
+			_ = json.Unmarshal(boKeysJSON, &item.ReferencedBOs)
+		}
+		interactions = append(interactions, item)
+	}
+
+	w.Header().Set("Content-Type", "application/json")
+	json.NewEncoder(w).Encode(map[string]interface{}{
+		"interactions": interactions,
+	})
+}
diff --git a/backend/internal/handlers/impact_simulator_handler.go b/backend/internal/handlers/impact_simulator_handler.go
new file mode 100644
index 000000000..b4850528c
--- /dev/null
+++ b/backend/internal/handlers/impact_simulator_handler.go
@@ -0,0 +1,167 @@
+package handlers
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"time"
+
+	"github.com/go-chi/chi/v5"
+	"github.com/google/uuid"
+	jwtmiddleware "github.com/hondyman/uisce/libs/jwt-middleware"
+
+	"github.com/hondyman/uisce/backend/internal/analytics"
+)
+
+type ImpactSimulatorHandler struct {
+	graphService  *analytics.SemanticGraphService
+	impactService *analytics.ImpactService
+}
+
+func NewImpactSimulatorHandler(graphService *analytics.SemanticGraphService, impactService *analytics.ImpactService) *ImpactSimulatorHandler {
+	return &ImpactSimulatorHandler{
+		graphService:  graphService,
+		impactService: impactService,
+	}
+}
+
+type BlastRadiusItem struct {
+	Category string `json:"category"`
+	Count    int    `json:"count"`
+	Detail   string `json:"detail"`
+	Severity string `json:"severity"`
+}
+
+type SimulateResponse struct {
+	BOKey       string            `json:"bo_key"`
+	SimulatedAt string            `json:"simulated_at"`
+	BlastRadius []BlastRadiusItem `json:"blast_radius"`
+}
+
+func (h *ImpactSimulatorHandler) RegisterRoutes(r chi.Router) {
+	r.Route("/api/v1/ai", func(sub chi.Router) {
+		sub.Get("/simulate", h.Simulate)
+	})
+}
+
+func (h *ImpactSimulatorHandler) Simulate(w http.ResponseWriter, r *http.Request) {
+	claims := jwtmiddleware.GetClaimsFromContext(r)
+	if claims == nil || claims.TenantID == "" {
+		http.Error(w, "unauthorized", http.StatusUnauthorized)
+		return
+	}
+
+	boKey := r.URL.Query().Get("bo_key")
+	if boKey == "" {
+		http.Error(w, "bo_key query parameter is required", http.StatusBadRequest)
+		return
+	}
+
+	tenantID, err := uuid.Parse(claims.TenantID)
+	if err != nil {
+		http.Error(w, "invalid tenant ID", http.StatusUnauthorized)
+		return
+	}
+
+	ctx, cancel := context.WithTimeout(r.Context(), 10*time.Second)
+	defer cancel()
+
+	boNode, err := h.graphService.FindBOByName(boKey, tenantID)
+	if err != nil {
+		http.Error(w, fmt.Sprintf("failed to lookup BO: %v", err), http.StatusInternalServerError)
+		return
+	}
+
+	if boNode == nil {
+		w.Header().Set("Content-Type", "application/json")
+		w.WriteHeader(http.StatusOK)
+		json.NewEncoder(w).Encode(SimulateResponse{
+			BOKey:       boKey,
+			SimulatedAt: time.Now().UTC().Format(time.RFC3339),
+			BlastRadius: []BlastRadiusItem{
+				{Category: "Downstream Reports", Count: 0, Detail: "No downstream reports found for this BO", Severity: "low"},
+				{Category: "Dependent BOs", Count: 0, Detail: "No dependent BOs found", Severity: "low"},
+				{Category: "Active Users", Count: 0, Detail: "No active user metrics available", Severity: "low"},
+				{Category: "Schema Dependencies", Count: 0, Detail: "No schema dependencies found", Severity: "low"},
+			},
+		})
+		return
+	}
+
+	depth := 5
+	graph, err := h.impactService.GetImpactGraph(ctx, boNode.ID.String(), analytics.NodeTypeBusinessObject, depth)
+	if err != nil {
+		http.Error(w, fmt.Sprintf("failed to compute blast radius: %v", err), http.StatusInternalServerError)
+		return
+	}
+
+	blastRadius := categorizeImpactGraph(graph, boKey)
+
+	w.Header().Set("Content-Type", "application/json")
+	json.NewEncoder(w).Encode(SimulateResponse{
+		BOKey:       boKey,
+		SimulatedAt: time.Now().UTC().Format(time.RFC3339),
+		BlastRadius: blastRadius,
+	})
+}
+
+func categorizeImpactGraph(graph *analytics.ImpactGraph, boKey string) []BlastRadiusItem {
+	var downstreamReports, dependentBOs, schemaDeps int
+
+	for _, node := range graph.Nodes {
+		if node.ID == "" {
+			continue
+		}
+		switch node.Type {
+		case analytics.NodeTypeBIArtifact, analytics.NodeTypeAPIEndpoint, analytics.NodeTypeAIArtifact:
+			downstreamReports++
+		case analytics.NodeTypeBusinessObject:
+			if node.Label != boKey {
+				dependentBOs++
+			}
+		case analytics.NodeTypeDBColumn, analytics.NodeTypeSemanticTerm:
+			schemaDeps++
+		}
+	}
+
+	return []BlastRadiusItem{
+		{
+			Category: "Downstream Reports",
+			Count:    downstreamReports,
+			Detail:   "Dashboards, scheduled reports, ad-hoc queries, and APIs referencing this BO",
+			Severity:  severity(downstreamReports, 15),
+		},
+		{
+			Category: "Dependent BOs",
+			Count:    dependentBOs,
+			Detail:   "Business Objects that reference columns or calculations from this BO",
+			Severity:  severity(dependentBOs, 8),
+		},
+		{
+			Category: "Active Users",
+			Count:    0,
+			Detail:   "User metrics require runtime query logging; not available in metadata graph",
+			Severity:  "low",
+		},
+		{
+			Category: "Schema Dependencies",
+			Count:    schemaDeps,
+			Detail:   "Source tables, columns, and semantic terms this BO depends on",
+			Severity:  severity(schemaDeps, 4),
+		},
+	}
+}
+
+func severity(count int, threshold int) string {
+	if count == 0 {
+		return "low"
+	}
+	ratio := float64(count) / float64(threshold)
+	if ratio > 1.0 {
+		return "high"
+	} else if ratio > 0.5 {
+		return "medium"
+	}
+	return "low"
+}
