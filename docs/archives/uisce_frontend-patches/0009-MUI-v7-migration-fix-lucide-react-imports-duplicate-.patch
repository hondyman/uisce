+// FindBOByName finds a business object node by name for a given tenant.
+// It searches across all datasources for the tenant.
+func (s *SemanticGraphService) FindBOByName(boName string, tenantID uuid.UUID) (*SemanticNode, error) {
+	nodeTypeID := s.getNodeTypeID(NodeTypeBusinessObject)
+	if nodeTypeID == uuid.Nil {
+		return nil, fmt.Errorf("unknown node type: business_object")
+	}
+
+	var node struct {
+		ID            uuid.UUID       `db:"id"`
+		NodeName      string          `db:"node_name"`
+		Description   sql.NullString  `db:"description"`
+		Properties    json.RawMessage `db:"properties"`
+		Config        json.RawMessage `db:"config"`
+		QualifiedPath string          `db:"qualified_path"`
+	}
+
+	err := s.db.Get(&node, `
+		SELECT id, node_name, description, properties, config, qualified_path
+		FROM catalog_node
+		WHERE node_type_id = $1 AND node_name = $2 AND tenant_id = $3
+		LIMIT 1
+	`, nodeTypeID, boName, tenantID)
+
+	if err == sql.ErrNoRows {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+
+	result := &SemanticNode{
+		ID:            node.ID,
+		NodeType:      string(NodeTypeBusinessObject),
+		NodeName:      node.NodeName,
+		Description:   node.Description.String,
+		QualifiedPath: node.QualifiedPath,
+	}
+	json.Unmarshal(node.Properties, &result.Properties)
+	json.Unmarshal(node.Config, &result.Config)
+
+	return result, nil
+}
