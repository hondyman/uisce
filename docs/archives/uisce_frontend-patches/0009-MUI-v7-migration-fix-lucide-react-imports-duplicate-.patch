diff --git a/frontend/scripts/add_box_import.py b/frontend/scripts/add_box_import.py
new file mode 100644
index 000000000..910880fa9
--- /dev/null
+++ b/frontend/scripts/add_box_import.py
@@ -0,0 +1,92 @@
+#!/usr/bin/env python3
+"""
+Add 'import { Box } from "@mui/material"' to files that use <Box but don't import it.
+"""
+
+import re, sys
+from pathlib import Path
+
+def needs_box_import(filepath: str) -> bool:
+    """Check if file uses <Box but doesn't import Box from @mui/material."""
+    path = Path(filepath)
+    if not path.exists():
+        return False
+    content = path.read_text(encoding='utf-8')
+
+    # Check if file uses <Box (but not just "Box" as a type)
+    if '<Box' not in content:
+        return False
+
+    # Check if Box is already imported
+    if re.search(r'from\s+"@mui/material"', content):
+        if re.search(r'import\s+\{[^}]*\bBox\b[^}]*\}\s+from\s+"@mui/material"', content):
+            return False
+        # Could be imported as default or with other patterns
+        if re.search(r'import\s+\{[^}]*\bBox\b[^}]*\}\s+from\s+"@mui/material"', content):
+            return False
+    return True
+
+def add_box_import(filepath: str) -> bool:
+    """Add Box import to a file that needs it."""
+    path = Path(filepath)
+    content = path.read_text(encoding='utf-8')
+
+    # Find where to insert the import
+    # Try to add to existing MUI imports, or add new import after React import
+
+    # Check for existing @mui/material imports
+    mui_import = re.search(r'(import\s+\{[^}]+\}\s+from\s+"@mui/material")', content)
+    if mui_import:
+        # Add Box to existing import
+        old_import = mui_import.group(1)
+        # Parse the imports
+        match = re.match(r'import\s+\{([^}]+)\}\s+from\s+"@mui/material"', old_import)
+        if match:
+            icons_str = match.group(1)
+            # Add Box to the import list (keep alphabetically sorted)
+            icons = [i.strip() for i in icons_str.split(',')]
+            if 'Box' not in icons:
+                icons.append('Box')
+                icons.sort()
+                new_import = f'import {{ {", ".join(icons)} }} from "@mui/material";'
+                content = content.replace(old_import, new_import)
+                path.write_text(content, encoding='utf-8')
+                return True
+    else:
+        # No @mui/material import - add a new import after React import
+        react_import = re.search(r'(import\s+\*\s+as\s+React\s+from\s+"react")', content)
+        if react_import:
+            insert_pos = react_import.end()
+            new_import = '\nimport { Box } from "@mui/material";'
+            content = content[:insert_pos] + new_import + content[insert_pos:]
+            path.write_text(content, encoding='utf-8')
+            return True
+        else:
+            # Try to find any import and add after it
+            first_import = re.search(r'^(import\s+.+?\s+from\s+["\'][^"\']+["\']\s*;?\n)', content, re.MULTILINE)
+            if first_import:
+                insert_pos = first_import.end()
+                new_import = 'import { Box } from "@mui/material";\n'
+                content = content[:insert_pos] + new_import + content[insert_pos:]
+                path.write_text(content, encoding='utf-8')
+                return True
+    return False
+
+def main():
+    files = sys.argv[1:]
+    if not files:
+        print("Usage: python3 add_box_import.py <files...>")
+        sys.exit(1)
+
+    for f in files:
+        if needs_box_import(f):
+            added = add_box_import(f)
+            if added:
+                print(f"  [ADDED] Box import to {f}")
+            else:
+                print(f"  [SKIP]  {f} (could not determine insertion point)")
+        else:
+            print(f"  [OK]    {f}")
+
+if __name__ == '__main__':
+    main()
