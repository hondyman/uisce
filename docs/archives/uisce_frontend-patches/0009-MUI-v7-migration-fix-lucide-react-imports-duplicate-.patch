+#!/usr/bin/env python3
+"""
+Fix MUI v7 SvgIcon size prop.
+MUI v7: <SvgIcon size={N}> → <SvgIcon sx={{ fontSize: N }}>
+"""
+
+import re
+import sys
+from pathlib import Path
+
+
+def fix_icon_size(content: str) -> tuple[str, int]:
+    changes = 0
+    original = content
+
+    def replace(m):
+        nonlocal changes
+        tag = m.group(0)
+        size_match2 = re.search(r'\bsize\s*=\s*\{([^}]+)\}', tag)
+        if not size_match2:
+            return tag
+        size_val = size_match2.group(1).strip()
+        new_tag = re.sub(r'\s*\bsize\s*=\s*\{[^}]+\}', '', tag)
+        new_tag = re.sub(r'\s+\/>', ' />', new_tag)
+        new_tag = new_tag.replace(' />', f' sx={{{{ fontSize: {size_val} }}}}/>')
+        changes += 1
+        return new_tag
+
+    content = re.sub(r'<[A-Z][A-Za-z0-9]+\b[^>]*\bsize\s*=\s*\{[^}]+\}[^>]*\/>', replace, content)
+    return content, changes
+
+
+def process_file(filepath: str, dry_run: bool = False) -> int:
+    path = Path(filepath)
+    if not path.exists():
+        return 0
+    original = path.read_text(encoding='utf-8')
+    new_content, changes = fix_icon_size(original)
+    if changes > 0 and not dry_run:
+        path.write_text(new_content, encoding='utf-8')
+        print(f"  [FIXED] {changes} size props in {filepath}")
+    elif changes > 0:
+        print(f"  [DRY] {changes} size props in {filepath}")
+    return changes
+
+
+def main():
+    dry_run = '--dry-run' in sys.argv
+    if dry_run:
+        sys.argv.remove('--dry-run')
+    files = sys.argv[1:]
+    if not files:
+        files = [str(p) for p in Path('src').rglob('*.tsx')]
+    total = sum(process_file(f, dry_run) for f in files)
+    print(f"\n{'Would fix' if dry_run else 'Fixed'}: {total} size props")
