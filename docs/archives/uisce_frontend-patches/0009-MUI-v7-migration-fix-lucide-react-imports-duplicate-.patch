+
+    # Self-closing: <IconName ... size={...} />
+    content = re.sub(
+        r'<([A-Z][A-Za-z0-9]*)\b([^>]*?)\bsize\s*=\s*\{([^}]+)\}([^>]*?)\s*/\s*>',
+        replace_icon,
+        content,
+        flags=re.DOTALL
+    )
+
+    return content, changes
+
+
+def process_file(filepath: str, dry_run: bool = False) -> int:
+    path = Path(filepath)
+    if not path.exists():
+        return 0
+
+    original = path.read_text(encoding='utf-8')
+    new_content, changes = fix_icon_size(original, filepath)
+
+    if changes > 0 and not dry_run:
+        path.write_text(new_content, encoding='utf-8')
+        print(f"  [FIXED] {changes} size props in {filepath}")
+    elif changes > 0:
+        print(f"  [DRY] {changes} size props in {filepath}")
+
+    return changes
+
+
+def main():
+    dry_run = '--dry-run' in sys.argv
+    if dry_run:
+        sys.argv.remove('--dry-run')
+
+    files = sys.argv[1:]
+    if not files:
+        src_dir = Path('src')
+        files = [str(p) for p in src_dir.rglob('*.tsx')]
+
+    total = sum(process_file(f, dry_run) for f in files)
+    print(f"\n{'Would fix' if dry_run else 'Fixed'}: {total} size props in icons")
+
+
+if __name__ == '__main__':
+    main()
