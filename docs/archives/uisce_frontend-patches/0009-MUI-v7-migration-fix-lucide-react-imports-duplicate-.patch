@@ -0,0 +1,70 @@
+package handlers
+
+import (
+	"encoding/json"
+	"net/http"
+
+	"github.com/go-chi/chi/v5"
+	jwtmiddleware "github.com/hondyman/uisce/libs/jwt-middleware"
+)
+
+type PersonalizationContextHandler struct{}
+
+func NewPersonalizationContextHandler() *PersonalizationContextHandler {
+	return &PersonalizationContextHandler{}
+}
+
+type IdentityContext struct {
+	TenantID        string   `json:"tenant_id"`
+	UserID          string   `json:"user_id"`
+	TenantIDs       []string `json:"tenant_ids"`
+	Email           string   `json:"email"`
+	FunctionalRole  string   `json:"functional_role"`
+	ClearanceLevel  string   `json:"clearance_level"`
+	Roles           []string `json:"roles"`
+}
+
+func (h *PersonalizationContextHandler) RegisterRoutes(r chi.Router) {
+	r.Route("/api/v1/personalization", func(sub chi.Router) {
+		sub.Get("/context", h.GetContext)
+	})
+}
+
+func (h *PersonalizationContextHandler) GetContext(w http.ResponseWriter, r *http.Request) {
+	claims := jwtmiddleware.GetClaimsFromContext(r)
+	if claims == nil || claims.TenantID == "" {
+		http.Error(w, "unauthorized", http.StatusUnauthorized)
+		return
+	}
+
+	functionalRole := "analyst"
+	clearanceLevel := "standard"
+	for _, role := range claims.Roles {
+		switch role {
+		case "admin", "ADMIN":
+			functionalRole = "administrator"
+			clearanceLevel = "elevated"
+		case "engineer", "data_engineer":
+			if functionalRole != "administrator" {
+				functionalRole = "engineer"
+				clearanceLevel = "elevated"
+			}
+		case "executive", "C-level":
+			if functionalRole != "administrator" {
+				functionalRole = "executive"
+				clearanceLevel = "confidential"
+			}
+		}
+	}
+
+	w.Header().Set("Content-Type", "application/json")
+	json.NewEncoder(w).Encode(IdentityContext{
+		TenantID:        claims.TenantID,
+		UserID:          claims.UserID,
+		TenantIDs:       claims.TenantIDs,
+		Email:           claims.Email,
+		FunctionalRole:  functionalRole,
+		ClearanceLevel:  clearanceLevel,
+		Roles:           claims.Roles,
+	})
+}
