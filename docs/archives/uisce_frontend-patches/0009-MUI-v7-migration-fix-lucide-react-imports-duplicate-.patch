+#!/usr/bin/env python3
+"""
+Tailwind removal codemod — conservative single-pass.
+- Self-closing elements with className: convert to Box component
+- Non-self-closing elements: strip className (visual regression, but no TS errors)
+- Void elements (input, img, br, hr): keep element, add sx prop directly
+
+This is the safe subset. Full Box migration requires matched open/close tag pairs
+which is complex for nested structures.
+"""
+
+import re
+import sys
+from pathlib import Path
+
+# ---------------------------------------------------------------------------
+# Token definitions (same as before)
+# ---------------------------------------------------------------------------
+
+def spacing_token(t: str) -> str:
+    if not t: return ''
+    if t.startswith('gap-'):
+        n = t[4:]
+        vals = {'0':'0','1':'0.5','2':'1','3':'1.5','4':'2','6':'3','8':'4','12':'6'}
+        return f'gap: {vals.get(n,n)}' if n in vals else ''
+    sides = {'mx':'marginX','my':'marginY','mt':'marginTop','mb':'marginBottom',
+             'ml':'marginLeft','mr':'marginRight','px':'paddingX','py':'paddingY',
+             'pt':'paddingTop','pb':'paddingBottom','pl':'paddingLeft','pr':'paddingRight'}
+    for side, prop in sides.items():
+        if t.startswith(side + '-'):
+            n = t[len(side)+1:]
+            val_map = {'0':0,'0.5':0.125,'1':0.5,'1.5':0.75,'2':1,'3':1.5,'4':2,'5':2.5,'6':3,'8':4,'10':5,'12':6}
+            v = val_map.get(n, None)
+            return f'{prop}: {v}' if v is not None else ''
+    return ''
+
+def _cmap() -> dict:
+    return {
+        'white': '#fff', 'black': '#000', 'current': 'currentColor',
+        'slate-50': '#f8fafc', 'slate-100': '#f1f5f9', 'slate-200': '#e2e8f0',
+        'slate-300': '#cbd5e1', 'slate-400': '#94a3b8', 'slate-500': '#64748b',
+        'slate-600': '#475569', 'slate-700': '#334155', 'slate-800': '#1e293b',
+        'slate-900': '#0f172a', 'slate-950': '#020617',
+        'gray-50': '#f9fafb', 'gray-100': '#f3f4f6', 'gray-200': '#e5e7eb',
+        'gray-300': '#d1d5db', 'gray-400': '#9ca3af', 'gray-500': '#6b7280',
+        'gray-600': '#4b5563', 'gray-700': '#374151', 'gray-800': '#1f2937', 'gray-900': '#111827',
+        'indigo-50': '#eef2ff', 'indigo-100': '#e0e7ff', 'indigo-200': '#c7d2fe',
+        'indigo-300': '#a5b4fc', 'indigo-400': '#818cf8', 'indigo-500': '#6366f1',
+        'indigo-600': '#4f46e5', 'indigo-700': '#4338ca', 'indigo-800': '#3730a3',
+        'indigo-900': '#312e81', 'indigo-950': '#1e1b4b',
+        'sky-50': '#f0f9ff', 'sky-100': '#e0f2fe', 'sky-200': '#bae6fd',
+        'sky-300': '#7dd3fc', 'sky-400': '#38bdf8', 'sky-500': '#0ea5e9',
+        'sky-600': '#0284c7', 'sky-700': '#0369a1', 'sky-800': '#075985',
+        'emerald-50': '#ecfdf5', 'emerald-100': '#d1fae5', 'emerald-200': '#a7f3d0',
+        'emerald-300': '#6ee7b7', 'emerald-400': '#34d399', 'emerald-500': '#10b981',
+        'emerald-600': '#059669', 'emerald-700': '#047857', 'emerald-800': '#065f46',
+        'amber-50': '#fffbeb', 'amber-100': '#fef3c7', 'amber-200': '#fde68a',
+        'amber-300': '#fcd34d', 'amber-400': '#fbbf24', 'amber-500': '#f59e0b', 'amber-600': '#d97706',
+        'red-50': '#fef2f2', 'red-100': '#fee2e2', 'red-200': '#fecaca',
+        'red-300': '#fca5a5', 'red-400': '#f87171', 'red-500': '#ef4444', 'red-600': '#dc2626',
+        'blue-50': '#eff6ff', 'blue-100': '#dbeafe', 'blue-200': '#bfdbfe',
+        'blue-300': '#93c5fd', 'blue-400': '#60a5fa', 'blue-500': '#3b82f6', 'blue-600': '#2563eb',
+        'green-50': '#f0fdf4', 'green-100': '#dcfce7', 'green-200': '#bbf7d0',
+        'green-300': '#86efac', 'green-400': '#4ade80', 'green-500': '#22c55e', 'green-600': '#16a34a',
+        'purple-50': '#faf5ff', 'purple-100': '#f3e8ff', 'purple-200': '#e9d5ff',
+        'purple-300': '#d8b4fe', 'purple-400': '#c084fc', 'purple-500': '#a855f7', 'purple-600': '#9333ea',
+    }
+
+def color_token(t: str, prefix: str) -> str:
+    cmap = _cmap()
+    if t in cmap:
+        prop = 'bgcolor' if prefix == 'bg' else 'color'
+        return f'{prop}: "{cmap[t]}"'
+    return ''
+
+def font_token(t: str) -> str:
+    m = {
+        'font-bold':'fontWeight: 700','font-semibold':'fontWeight: 600','font-medium':'fontWeight: 500',
+        'font-normal':'fontWeight: 400','font-light':'fontWeight: 300','italic':'fontStyle: "italic"',
+        'underline':'textDecoration: "underline"','line-through':'textDecoration: "line-through"',
+        'uppercase':'textTransform: "uppercase"','lowercase':'textTransform: "lowercase"','capitalize':'textTransform: "capitalize"',
+        'text-left':'textAlign: "left"','text-center':'textAlign: "center"','text-right':'textAlign: "right"',
+        'tracking-wider':'letterSpacing: "0.05em"','tracking-wide':'letterSpacing: "0.025em"',
+        'whitespace-nowrap':'whiteSpace: "nowrap"','truncate':'overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap"',
+    }
+    return m.get(t,'')
+
+def size_token(t: str) -> str:
+    return {
+        'text-xs':'fontSize: "0.7rem"','text-sm':'fontSize: "0.8rem"','text-base':'fontSize: "0.9rem"',
+        'text-lg':'fontSize: "1rem"','text-xl':'fontSize: "1.1rem"','text-2xl':'fontSize: "1.25rem"',
+        'text-3xl':'fontSize: "1.5rem"','text-4xl':'fontSize: "2rem"',
+    }.get(t,'')
+
+def border_color_token(t: str) -> str:
+    if not t.startswith('border-') or t == 'border': return ''
+    return color_token(t[7:], '')
+
+def layout_token(t: str) -> str:
+    return {
+        'flex':'display: "flex"','inline-flex':'display: "inline-flex"','grid':'display: "grid"',
+        'hidden':'display: "none"','block':'display: "block"','inline-block':'display: "inline-block"',
+        'w-full':'width: "100%"','w-1/2':'width: "50%"','w-1/3':'width: "33.333%"','w-2/3':'width: "66.667%"',
+        'w-1/4':'width: "25%"','w-3/4':'width: "75%"',
+        'h-full':'height: "100%"','h-screen':'height: "100vh"',
+        'h-4':'height: 16','h-5':'height: 20','h-6':'height: 24','h-8':'height: 32','h-10':'height: 40','h-12':'height: 48',
+        'h-1':'height: 4','h-2':'height: 8','h-3':'height: 12',
+        'min-h-screen':'minHeight: "100vh"','overflow-hidden':'overflow: "hidden"',
+        'overflow-y-auto':'overflowY: "auto"','overflow-x-auto':'overflowX: "auto"',
+        'mx-auto':'mx: "auto"',
+        'relative':'position: "relative"','absolute':'position: "absolute"','fixed':'position: "fixed"',
+        'inset-0':'inset: 0','top-0':'top: 0','right-0':'right: 0','bottom-0':'bottom: 0','left-0':'left: 0',
+        'cursor-pointer':'cursor: "pointer"','cursor-not-allowed':'cursor: "not-allowed"',
+        'z-50':'zIndex: 50','z-40':'zIndex: 40','z-30':'zIndex: 30','z-20':'zIndex: 20','z-10':'zIndex: 10',
+        'flex-1':'flex: 1','flex-auto':'flex: "auto"','flex-wrap':'flexWrap: "wrap"',
+        'flex-col':'flexDirection: "column"','flex-row':'flexDirection: "row"','shrink-0':'flexShrink: 0',
+        'items-center':'alignItems: "center"','items-start':'alignItems: "flex-start"','items-end':'alignItems: "flex-end"',
+        'items-stretch':'alignItems: "stretch"','justify-between':'justifyContent: "space-between"',
+        'justify-center':'justifyContent: "center"','justify-end':'justifyContent: "flex-end"',
+        'self-center':'alignSelf: "center"','self-start':'alignSelf: "flex-start"','self-end':'alignSelf: "flex-end"',
+        'border':'border: "1px solid"','border-b':'borderBottom: "1px solid"','border-t':'borderTop: "1px solid"',
+        'border-l':'borderLeft: "1px solid"','border-r':'borderRight: "1px solid"','border-b-2':'borderBottom: "2px solid"',
+        'rounded-none':'borderRadius: 0','rounded':'borderRadius: 4','rounded-sm':'borderRadius: 2',
+        'rounded-md':'borderRadius: 6','rounded-lg':'borderRadius: 8','rounded-xl':'borderRadius: 12',
+        'rounded-2xl':'borderRadius: 16','rounded-3xl':'borderRadius: 24','rounded-full':'borderRadius: "50%"',
+        'shadow-sm':'boxShadow: 1','shadow':'boxShadow: 2','shadow-md':'boxShadow: 3',
+        'shadow-lg':'boxShadow: 5','shadow-xl':'boxShadow: 8','shadow-2xl':'boxShadow: 16',
+        'shadow-none':'boxShadow: "none"',
+        'transition-colors':'transition: "color 0.15s, background-color 0.15s, border-color 0.15s, fill 0.15s"',
+        'transition-all':'transition: "all 0.2s"','transition-opacity':'transition: "opacity 0.2s"',
+        'animate-spin':'animation: "spin 1s linear infinite"','animate-pulse':'animation: "pulse 2s infinite"',
+        'sr-only':'position: "absolute", width: 1, height: 1, padding: 0, margin: -1, overflow: "hidden", clip: "rect(0,0,0,0)", whiteSpace: "nowrap", border: 0',
+        'pointer-events-none':'pointerEvents: "none"','select-none':'userSelect: "none"',
+        'backdrop-blur-md':'backdropFilter: "blur(8px)"','backdrop-blur-sm':'backdropFilter: "blur(4px)"',
+    }.get(t,'')
+
+# Tags that accept sx prop natively (no TypeScript errors)
+SX_NATIVE = {'input', 'select', 'textarea', 'img', 'a', 'button'}
+
+
+def tw_to_sx(class_str: str) -> tuple[str, dict]:
+    if not class_str: return '', {}
+    tokens = class_str.split()
+    sx_parts, pseudo = [], {}
+    for t in tokens:
+        if t.startswith('hover:'):
+            inner=t[6:]; sx,_=tw_to_sx(inner)
+            if sx: pseudo['&:hover']=sx; continue
+        if t.startswith('focus:'):
+            inner=t[7:]; sx,_=tw_to_sx(inner)
+            if sx: pseudo['&:focus']=sx; continue
+        if t.startswith('disabled:'):
+            inner=t[9:]; sx,_=tw_to_sx(inner)
+            if sx: pseudo['&:disabled']=sx; continue
+        s=spacing_token(t)
+        if s: sx_parts.append(s); continue
+        c=color_token(t,'bg')
+        if c: sx_parts.append(c); continue
+        c=color_token(t,'text')
+        if c: sx_parts.append(c); continue
+        b=border_color_token(t)
+        if b: sx_parts.append(b); continue
+        l=layout_token(t)
+        if l: sx_parts.append(l); continue
+        f=font_token(t)
+        if f: sx_parts.append(f); continue
+        sz=size_token(t)
+        if sz: sx_parts.append(sz); continue
+    parts=[sx for sx in sx_parts]
+    for k,v in pseudo.items(): parts.append(f'"{k}": {{{v}}}')
+    return ', '.join(sx_parts), pseudo
+
+
+def convert_tsx(content: str, dry_run: bool = False) -> tuple[str, int]:
+    changes = 0
+
+    def make_sx(sx: str, pseudo: dict) -> str:
+        parts=[sx] if sx else []
+        for k,v in pseudo.items(): parts.append(f'"{k}": {{{v}}}')
+        return ', '.join(parts)
+
+    def replace_sc(m):
+        """Handle self-closing elements: <TAG className="..." />"""
+        nonlocal changes
+        tag=m.group(1); cls=m.group(2)
+        sx,pseudo=tw_to_sx(cls)
+        sx_str=make_sx(sx,pseudo)
+        if not sx_str:
+            changes+=1
+            if dry_run: return m.group(0)
+            return f'<{tag} />'
+        changes+=1
+        if dry_run: return m.group(0)
+        if tag in SX_NATIVE:
+            return f'<{tag} sx={{{{{sx_str}}}}}/>'
+        return f'<Box component="{tag}" sx={{{{{sx_str}}}}}/>'
+
+    def replace_open(m):
+        """Handle open elements: <TAG className="..."> — strip className"""
+        nonlocal changes
+        tag=m.group(1)
+        changes+=1
+        if dry_run: return m.group(0)
+        return f'<{tag}>'
+
+    # Pattern 1: self-closing with className
+    sc_pattern = r'<((?:div|span|p|h[1-6]|section|article|aside|header|footer|main|nav|ul|ol|li|form|label|a|button|table|thead|tbody|tr|th|td|blockquote|pre|code|hr|br|img|input|select|textarea|path|svg|rect|circle|ellipse|line|polyline|polygon))\s+className="([^"]+)"\s*/>'
+    content, n = re.subn(sc_pattern, replace_sc, content)
+    changes += n
+
+    # Pattern 2: open tag with className (strip className, keep element)
+    open_pattern = r'<((?:div|span|p|h[1-6]|section|article|aside|header|footer|main|nav|ul|ol|li|form|label|a|button|table|thead|tbody|tr|th|td|blockquote|pre|code|hr|br|img|input|select|textarea))\s+className="([^"]+)"\s*>'
+    content, n = re.subn(open_pattern, replace_open, content)
+    changes += n
+
+    return content, changes
+
+
+def process_file(filepath: str, dry_run: bool = False) -> int:
+    path = Path(filepath)
+    if not path.exists():
+        print(f"  [SKIP] {filepath}")
+        return 0
+    original = path.read_text(encoding='utf-8')
+    converted, n = convert_tsx(original, dry_run=dry_run)
+    if dry_run:
+        if n > 0: print(f"  [DRY] {n} in {filepath}")
+        return n
+    else:
+        if n > 0:
+            path.write_text(converted, encoding='utf-8')
+            print(f"  [MIGRATED] {n} in {filepath}")
+        return n
+
+
+def main():
+    dry_run = '--dry-run' in sys.argv
+    if dry_run: sys.argv.remove('--dry-run')
+    files = sys.argv[1:]
+    if not files:
+        print("Usage: python3 scripts/migrate_tailwind_to_mui.py [--dry-run] <files...>")
+        sys.exit(1)
+    total=sum(process_file(f, dry_run) for f in files)
+    print(f"\n{'Would migrate' if dry_run else 'Migrated'}: {total} changes across {len(files)} files")
+
+if __name__ == '__main__':
+    main()
