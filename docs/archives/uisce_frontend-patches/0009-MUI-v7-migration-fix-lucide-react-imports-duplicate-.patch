+    'ZodiacVirgo': 'Agriculture',
+}
+
+# Only icons that have a mapping
+KNOWN_ICONS = set(ICON_MAP.keys())
+
+def icon_to_mui(icon: str) -> str:
+    return ICON_MAP.get(icon, None)
+
+def process_file(filepath: str, dry_run: bool = False) -> int:
+    path = Path(filepath)
+    if not path.exists():
+        print(f"  [SKIP] {filepath}")
+        return 0
+
+    original = path.read_text(encoding='utf-8')
+    content = original
+    changes = 0
+
+    # Collect which icons were mapped in this file
+    mapped_icons = {}  # lucide_name -> mui_name
+
+    # Step 1: Update imports
+    import_pattern = r'import\s+\{([^}]+)\}\s+from\s+["\']lucide-react["\']'
+
+    def replace_import(m):
+        nonlocal changes
+        icons_str = m.group(1)
+        icons = [i.strip() for i in icons_str.split(',')]
+        new_icons = []
+        unmapped = []
+        for icon in icons:
+            icon = icon.strip()
+            if not icon:
+                continue
+            if icon in ICON_MAP:
+                new_icons.append(ICON_MAP[icon])
+                mapped_icons[icon] = ICON_MAP[icon]
+                changes += 1
+            else:
+                unmapped.append(icon)
+
+        if not new_icons:
+            return f'// REMOVED: {m.group(0)}'
+
+        import_line = f'import {{ {", ".join(new_icons)} }} from "@mui/icons-material";'
+        if unmapped:
+            import_line += f' // TODO: replace: {", ".join(unmapped)}'
+        return import_line
+
+    content = re.sub(import_pattern, replace_import, content)
+
+    # Step 2: Replace JSX usages of mapped icons
+    if mapped_icons:
+        for lucide_name, mui_name in mapped_icons.items():
+            # Replace self-closing: <IconName /> or <IconName/>
+            content = re.sub(
+                rf'<{lucide_name}\s*/>', f'<{mui_name} />', content
+            )
+            # Replace opening tags: <IconName ...> or <IconName>
+            # Must be word boundary before <
+            content = re.sub(
+                rf'<{lucide_name}(?!\w)(?![^>]*\w/{lucide_name})([^>]*?)>',  # skip if has children /IconName
+                lambda m: f'<{mui_name}{m.group(1)}>', content, flags=re.DOTALL
+            )
+            # Replace closing tags: </IconName>
+            content = re.sub(
+                rf'</{lucide_name}>', f'</{mui_name}>', content
+            )
+
+    if not dry_run:
+        path.write_text(content, encoding='utf-8')
+        print(f"  [MIGRATED] {changes} icons in {filepath}")
+    elif changes > 0:
+        print(f"  [DRY] {changes} icons in {filepath}")
+
+    return changes
+
+def main():
+    dry_run = '--dry-run' in sys.argv
+    if dry_run:
+        sys.argv.remove('--dry-run')
+
+    files = sys.argv[1:]
+    if not files:
+        print("Usage: python3 scripts/replace_lucide_icons.py [--dry-run] <files...>")
+        sys.exit(1)
+
+    total = sum(process_file(f, dry_run) for f in files)
+    print(f"\n{'Would migrate' if dry_run else 'Migrated'}: {total} icon replacements across {len(files)} files")
+
+if __name__ == '__main__':
+    main()
