{
  "name": "orm-oms-connector-v2",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "tasks.max": "1",

    "database.hostname": "100.84.50.65",
    "database.port": "5432",
    "database.user": "postgres",
    "database.password": "REPLACE_WITH_POSTGRES_PASSWORD",
    "database.dbname": "alpha",
    "database.sslmode": "verify-full",
    "database.sslrootcert": "/tmp/orm_ca.crt",
    "database.sslcert": "/tmp/orm_client.crt",
    "database.sslkey": "/tmp/orm_client_der.pk8",

    "topic.prefix": "orm_oms",
    "schema.include.list": "orm",

    "table.include.list": "orm.execution,orm.order,orm.placement,orm.order_allocation,orm.execution_allocation,orm.debezium_heartbeat",

    "plugin.name": "pgoutput",
    "publication.name": "orm_cdc_publication",
    "publication.autocreate.mode": "disabled",
    "slot.name": "orm_oms_slot",

    "snapshot.mode": "initial",

    "decimal.handling.mode": "string",
    "time.precision.mode": "connect",
    "tombstones.on.delete": "false",

    "heartbeat.interval.ms": "10000",
    "heartbeat.action.query": "UPDATE orm.debezium_heartbeat SET last_heartbeat = now() WHERE id = 1"
  }
}