# Copy to tenants.env (gitignored), fill in real secrets.
# Rendered SQL and tenants.env must never be committed.

# Root hardening — run once; refuse to re-run after first rotation.
# After the first apply pass, set STARROCKS_ROOT_PASSWORD in the real
# tenants.env (Infisical) and remove the commented ALTER USER line in
# tenant_rbac.sql.tpl to enforce it.
# ${VAR_NAME} interpolation (no quotes) is the convention documented in
# AGENTS.md ("uisce-infisical password migration"); empty strings trip the
# pre-push secret-scratcher.
STARROCKS_ROOT_PASSWORD=${STARROCKS_ROOT_PASSWORD}

# Per-tenant service credentials (min 24 chars, generate: openssl rand -base64 24)
TENANT_NORTHWINDS_PASSWORD=${TENANT_NORTHWINDS_PASSWORD}
TENANT_CRD_BAKEOFF_PASSWORD=${TENANT_CRD_BAKEOFF_PASSWORD}

# Stream-loader user (least privilege, writes only lakehouse tables).
# One role ("loader") with INSERT on both tenant DBs — loaders are not
# tenant-scoped; each loader binary targets one specific table.
STREAM_LOADER_PASSWORD=${STREAM_LOADER_PASSWORD}

FE_HOST=127.0.0.1
FE_QUERY_PORT=9030

# === Per-tenant DSN overrides ===
# Set LAKEHOUSE_STARROCKS_DSN_TENANT_<KEY> for any tenant that needs its own
# user/password instead of the legacy LAKEHOUSE_STARROCKS_DSN. The <KEY> is the
# tenant name passed at runtime (via AuditDestinationSpec.TenantName) run
# through tenantEnvKey() — uppercase ASCII letters/digits, runs of non-
# alphanumeric chars collapsed to a single underscore, edges stripped.
#
# Examples (assuming TenantName passed by the caller is "northwinds" or
# "Demo Tenant CRD Bakeoff"):
#   LAKEHOUSE_STARROCKS_DSN_TENANT_NORTHWINDS="tenant_northwinds_svc:<pw>@tcp(starrocks-fe:9030)/tenant_northwinds"
#   LAKEHOUSE_STARROCKS_DSN_TENANT_DEMO_TENANT_CRD_BAKEOFF="tenant_crd_bakeoff_svc:<pw>@tcp(starrocks-fe:9030)/tenant_crd_bakeoff"
#
# Strict mode: refuse the legacy fallback for unmapped tenants.
#   LAKEHOUSE_STARROCKS_REQUIRE_TENANT_DSN="true"

# === Per-tenant init-resource-group opt-in (3.3 only; leave absent on 4.1) ===
# Appends `SET resource_group = '<rg>'` to every new connection for the tenant
# that has this var set. Per-tenant (NOT global) because on StarRocks the SET
# overrides classifier routing — a global value would pin every tenant to one
# group and defeat the isolation the resource groups were built for.
#
# Use this for belt-and-braces on 3.3 only:
#   - classifier in the resource-group definition already routes by user.
#   - the SET is redundant unless classifier matching has gaps.
#   - on 4.1 the session-variable name may have changed; leaving this unset
#     keeps `initConnector.Connect` succeeding.
#
# Mirror the DSN convention: one env var per tenant, scoped by slug.
#   LAKEHOUSE_STARROCKS_INIT_RESOURCE_GROUP_TENANT_NORTHWINDS="tenant_northwinds_wg"
#   LAKEHOUSE_STARROCKS_INIT_RESOURCE_GROUP_TENANT_CRD_BAKEOFF="tenant_crd_bakeoff_wg"
#
# DO NOT use the old single-value `LAKEHOUSE_STARROCKS_INIT_RESOURCE_GROUP=...`
# form. It is gone and applying it pins every tenant to one group.