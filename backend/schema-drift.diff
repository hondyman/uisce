+--
+-- Name: semantic_drift_summary; Type: MATERIALIZED VIEW; Schema: public; Owner: -
+--
+
+CREATE MATERIALIZED VIEW public.semantic_drift_summary AS
+ SELECT r.tenant_id,
+    r.model_id,
+    r.report_time,
+    r.drift_severity,
+    count(DISTINCT i.id) AS issue_count,
+    count(DISTINCT
+        CASE
+            WHEN ((i.severity)::text = 'critical'::text) THEN i.id
+            ELSE NULL::uuid
+        END) AS critical_issues,
+    count(DISTINCT
+        CASE
+            WHEN ((i.severity)::text = 'high'::text) THEN i.id
+            ELSE NULL::uuid
+        END) AS high_issues
+   FROM (public.semantic_drift_reports r
+     LEFT JOIN public.semantic_drift_issues i ON ((r.id = i.report_id)))
+  WHERE (r.report_time > (now() - '30 days'::interval))
+  GROUP BY r.tenant_id, r.model_id, r.report_time, r.drift_severity
+  WITH NO DATA;
+
