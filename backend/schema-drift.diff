+--
+-- Name: v_advisor_task_queue; Type: VIEW; Schema: public; Owner: -
+--
+
+CREATE VIEW public.v_advisor_task_queue AS
+ SELECT at.task_id,
+    at.advisor_id,
+    at.client_id,
+    at.task_type,
+    at.title,
+    at.priority,
+    at.due_date,
+    at.status,
+    io.fund_name AS related_fund,
+    io.current_stage AS opportunity_stage,
+        CASE
+            WHEN (at.due_date < now()) THEN 'OVERDUE'::text
+            WHEN (at.due_date < (now() + '1 day'::interval)) THEN 'DUE_TODAY'::text
+            WHEN (at.due_date < (now() + '7 days'::interval)) THEN 'DUE_THIS_WEEK'::text
+            ELSE 'UPCOMING'::text
+        END AS urgency
+   FROM (public.advisor_tasks at
+     LEFT JOIN public.investment_opportunities io ON ((at.opportunity_id = io.opportunity_id)))
+  WHERE ((at.status)::text = ANY ((ARRAY['PENDING'::character varying, 'IN_PROGRESS'::character varying])::text[]))
+  ORDER BY
+        CASE at.priority
+            WHEN 'CRITICAL'::text THEN 1
+            WHEN 'HIGH'::text THEN 2
+            WHEN 'MEDIUM'::text THEN 3
+            ELSE 4
+        END, at.due_date;
+
+
+--
+-- Name: v_impersonation_activity_feed; Type: VIEW; Schema: public; Owner: -
+--
+
+CREATE VIEW public.v_impersonation_activity_feed AS
+ SELECT s.session_id AS impersonation_id,
+    s.admin_email,
+    s.admin_role,
+    s.ticket_reference,
+    s.target_tenant_id,
+    s.scope_kind,
+    s.scope_id,
+    a.bo_key,
+    a.bo_instance_id,
+    a.state_transition,
+    a.payload_snapshot,
+    a.executed_at AS action_timestamp
+   FROM (public.platform_admin_audit s
+     JOIN public.impersonation_action_audit a ON ((s.session_id = a.impersonation_id)))
+  WHERE (s.event_type = 'IMPERSONATION_START'::text)
+  ORDER BY a.executed_at DESC;
+
+
