+--
+-- Name: v_aso_cost_summary; Type: VIEW; Schema: semantic; Owner: -
+--
+
+CREATE VIEW semantic.v_aso_cost_summary AS
+ SELECT env,
+    tenant_id,
+    count(*) FILTER (WHERE (status = 'applied'::text)) AS applied_count,
+    sum((((details -> 'cost_metrics'::text) ->> 'net_savings_per_day'::text))::numeric) AS daily_savings,
+    sum((((details -> 'cost_metrics'::text) ->> 'total_savings_to_date'::text))::numeric) AS total_savings,
+    sum((((details -> 'cost_metrics'::text) ->> 'total_costs_to_date'::text))::numeric) AS total_costs
+   FROM semantic.aso_optimization
+  WHERE ((details -> 'cost_metrics'::text) IS NOT NULL)
+  GROUP BY env, tenant_id;
+
+
+--
+-- Name: v_experiment_summary; Type: VIEW; Schema: semantic; Owner: -
+--
+
+CREATE VIEW semantic.v_experiment_summary AS
+ SELECT e.id,
+    e.name,
+    e.status,
+    e.outcome,
+    e.traffic_percent,
+    e.started_at,
+    e.ended_at,
+    o.target_name,
+    o.optimization_type,
+    ((e.metrics_json ->> 'improvement_pct'::text))::numeric AS improvement_pct,
+    ((e.metrics_json ->> 'p_value'::text))::numeric AS p_value,
+    ((e.metrics_json ->> 'significant'::text))::boolean AS significant
+   FROM (semantic.aso_experiment e
+     JOIN semantic.aso_optimization o ON ((e.optimization_id = o.id)));
+
