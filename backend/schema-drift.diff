+--
+-- Name: resolve_backend_capabilities(uuid, uuid); Type: FUNCTION; Schema: public; Owner: -
+--
+
+CREATE FUNCTION public.resolve_backend_capabilities(p_backend_id uuid, p_tenant_id uuid) RETURNS TABLE(backend_id uuid, engine_type text, is_directly_writeable boolean, supports_time_travel boolean, supports_ctas boolean, supports_distributed boolean, connection_pooling_mode text, default_context_hint text, temporal_strategy text, command_topic_template text, resolved_tenant_id uuid, precedence_rank integer)
+    LANGUAGE sql STABLE
+    AS $$
+    WITH ranked AS (
+        SELECT
+            bec.*,
+            ROW_NUMBER() OVER (
+                PARTITION BY bec.backend_id
+                ORDER BY
+                    CASE WHEN bec.tenant_id = p_tenant_id THEN 1
+                         WHEN bec.tenant_id IS NULL     THEN 2
+                         ELSE 3 END,
+                    bec.updated_at DESC
+            ) AS precedence_rank
+        FROM public.backend_engine_capabilities bec
+        WHERE bec.backend_id = p_backend_id
+          AND (bec.tenant_id = p_tenant_id OR bec.tenant_id IS NULL)
+    )
+    SELECT
+        ranked.backend_id,
+        ranked.engine_type,
+        ranked.is_directly_writeable,
+        ranked.supports_time_travel,
+        ranked.supports_ctas,
+        ranked.supports_distributed,
+        ranked.connection_pooling_mode,
+        ranked.default_context_hint,
+        ranked.temporal_strategy,
+        ranked.command_topic_template,
+        ranked.tenant_id,
+        ranked.precedence_rank
+    FROM ranked
+    WHERE ranked.precedence_rank = 1
+    LIMIT 1;
+$$;
+
