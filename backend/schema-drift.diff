+--
+-- Name: monthly_revenue_summary; Type: VIEW; Schema: public; Owner: -
+--
+
+CREATE VIEW public.monthly_revenue_summary AS
+ SELECT date_trunc('month'::text, (billing_period_end)::timestamp with time zone) AS month,
+    count(DISTINCT client_id) AS clients_billed,
+    count(*) AS total_invoices,
+    sum(aum_based_fee) AS total_aum_fees,
+    sum(performance_fee) AS total_performance_fees,
+    sum(((planning_fee + hourly_fees) + other_fees)) AS total_other_fees,
+    sum(net_fee) AS total_revenue,
+    sum(payment_amount) AS total_collected,
+    sum(
+        CASE
+            WHEN ((calculation_status)::text = 'PAID'::text) THEN 1
+            ELSE 0
+        END) AS invoices_paid,
+    sum(
+        CASE
+            WHEN ((calculation_status)::text = ANY ((ARRAY['INVOICED'::character varying, 'PARTIALLY_PAID'::character varying])::text[])) THEN (net_fee - COALESCE(payment_amount, (0)::numeric))
+            ELSE (0)::numeric
+        END) AS outstanding_ar
+   FROM public.fee_calculations fc
+  WHERE ((calculation_status)::text <> 'DRAFT'::text)
+  GROUP BY (date_trunc('month'::text, (billing_period_end)::timestamp with time zone))
+  ORDER BY (date_trunc('month'::text, (billing_period_end)::timestamp with time zone)) DESC;
+
+
+--
+-- Name: mv_client_alt_exposure; Type: MATERIALIZED VIEW; Schema: public; Owner: -
+--
+
+CREATE MATERIALIZED VIEW public.mv_client_alt_exposure AS
+ SELECT cat.client_id,
+    cat.max_alternatives_pct,
+    cat.min_liquid_assets_pct,
+    COALESCE(sum(
+        CASE
+            WHEN ((io.current_stage)::text = 'FUNDED'::text) THEN io.target_commitment
+            ELSE (0)::numeric
+        END), (0)::numeric) AS committed_value,
+    COALESCE(sum(
+        CASE
+            WHEN ((io.current_stage)::text = ANY ((ARRAY['INTAKE'::character varying, 'INITIAL_SCREEN'::character varying, 'DUE_DILIGENCE'::character varying, 'INVESTMENT_COMMITTEE'::character varying, 'APPROVED'::character varying, 'DOCUMENTATION'::character varying])::text[])) THEN io.target_commitment
+            ELSE (0)::numeric
+        END), (0)::numeric) AS pipeline_value,
+    count(DISTINCT io.opportunity_id) AS total_opportunities,
+    count(DISTINCT
+        CASE
+            WHEN ((io.current_stage)::text = 'FUNDED'::text) THEN io.opportunity_id
+            ELSE NULL::uuid
+        END) AS funded_count
+   FROM (public.client_allocation_targets cat
+     LEFT JOIN public.investment_opportunities io ON ((cat.client_id = io.client_id)))
+  WHERE ((cat.effective_date <= CURRENT_DATE) AND ((cat.end_date IS NULL) OR (cat.end_date > CURRENT_DATE)))
+  GROUP BY cat.client_id, cat.max_alternatives_pct, cat.min_liquid_assets_pct
+  WITH NO DATA;
+
+
+--
+-- Name: mv_pipeline_summary; Type: MATERIALIZED VIEW; Schema: public; Owner: -
+--
+
+CREATE MATERIALIZED VIEW public.mv_pipeline_summary AS
+ SELECT advisor_id,
+    opportunity_type,
+    current_stage,
+    count(*) AS count,
+    sum(target_commitment) AS total_value,
+    avg(screening_score) AS avg_screening_score,
+    avg(ai_fit_score) AS avg_fit_score,
+    min(created_at) AS oldest_created,
+    (avg((EXTRACT(epoch FROM (now() - stage_updated_at)) / (86400)::numeric)))::integer AS avg_days_in_stage
+   FROM public.investment_opportunities
+  WHERE ((current_stage)::text <> ALL ((ARRAY['CLOSED_WON'::character varying, 'CLOSED_LOST'::character varying])::text[]))
+  GROUP BY advisor_id, opportunity_type, current_stage
+  WITH NO DATA;
+
