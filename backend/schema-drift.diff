+--
+-- Name: v_upcoming_capital_events; Type: VIEW; Schema: public; Owner: -
+--
+
+CREATE VIEW public.v_upcoming_capital_events AS
+ SELECT ce.event_id,
+    ce.client_id,
+    ai.fund_name,
+    ce.event_type,
+    ce.due_date,
+    ce.amount,
+    ce.status,
+    ce.liquidity_check_passed,
+    (ce.due_date - CURRENT_DATE) AS days_until_due
+   FROM (public.capital_events ce
+     JOIN public.alternative_investments ai ON ((ce.investment_id = ai.investment_id)))
+  WHERE ((ce.due_date >= CURRENT_DATE) AND ((ce.status)::text <> ALL ((ARRAY['FUNDED'::character varying, 'PAID'::character varying, 'CANCELLED'::character varying])::text[])))
+  ORDER BY ce.due_date;
