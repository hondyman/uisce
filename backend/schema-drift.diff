+CREATE FUNCTION aggregates.get_preaggregated_metric(p_node_id character varying, p_grain_values jsonb, p_max_age_hours integer DEFAULT 24) RETURNS TABLE(id uuid, value numeric, last_refresh timestamp with time zone, is_fresh boolean, hours_old numeric)
+    LANGUAGE plpgsql
+    AS $$
+BEGIN
+    RETURN QUERY
+    SELECT
+        pam.id,
+        pam.value,
+        pam.last_refresh,
+        (EXTRACT(EPOCH FROM (NOW() - pam.last_refresh)) / 3600) <= p_max_age_hours AS is_fresh,
+        EXTRACT(EPOCH FROM (NOW() - pam.last_refresh)) / 3600 AS hours_old
+    FROM aggregates.preaggregated_metrics pam
+    WHERE pam.node_id = p_node_id
+    AND pam.grain_values @> p_grain_values
+    ORDER BY pam.last_refresh DESC
+    LIMIT 1;
+END;
+$$;
 
 
