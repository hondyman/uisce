+--
+-- Name: get_translation(character varying, character varying, uuid, character varying, character varying); Type: FUNCTION; Schema: public; Owner: -
+--
+
+CREATE FUNCTION public.get_translation(p_context character varying, p_entity_type character varying, p_entity_id uuid, p_key character varying, p_language_code character varying DEFAULT 'en'::character varying) RETURNS text
+    LANGUAGE plpgsql STABLE
+    AS $$
+DECLARE
+  v_translation text;
+  v_fallback text;
+BEGIN
+  -- Try to get translation in requested language
+  SELECT value INTO v_translation
+  FROM public.translations
+  WHERE context = p_context
+    AND entity_type = p_entity_type
+    AND entity_id = p_entity_id
+    AND key = p_key
+    AND language_code = p_language_code;
+  
+  -- If not found, try default language (English)
+  IF v_translation IS NULL THEN
+    SELECT value INTO v_fallback
+    FROM public.translations
+    WHERE context = p_context
+      AND entity_type = p_entity_type
+      AND entity_id = p_entity_id
+      AND key = p_key
+      AND language_code = 'en';
+    
+    RETURN COALESCE(v_translation, v_fallback);
+  END IF;
+  
+  RETURN v_translation;
+END;
+$$;
+
