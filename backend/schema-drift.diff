+           FROM public.secure_messages
+          WHERE ((secure_messages.recipient_id = c.id) AND (secure_messages.read_at IS NULL))) AS unread_messages,
+    ( SELECT count(*) AS count
+           FROM public.notifications
+          WHERE ((notifications.recipient_id = c.id) AND (notifications.read_at IS NULL) AND (notifications.dismissed_at IS NULL))) AS unread_notifications,
+    ( SELECT count(*) AS count
+           FROM public.recommended_actions
+          WHERE ((recommended_actions.client_id = c.id) AND ((recommended_actions.status)::text = ANY ((ARRAY['PENDING'::character varying, 'PRESENTED'::character varying])::text[])))) AS pending_actions,
+    ( SELECT count(*) AS count
+           FROM public.client_goals
+          WHERE ((client_goals.client_id = c.id) AND ((client_goals.status)::text = 'ACTIVE'::text))) AS active_goals
+   FROM public.clients c;
