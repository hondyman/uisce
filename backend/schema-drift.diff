+--
+-- Name: client_billing_summary; Type: VIEW; Schema: public; Owner: -
+--
+
+CREATE VIEW public.client_billing_summary AS
+ SELECT client_id,
+    count(*) AS total_invoices,
+    sum(net_fee) AS lifetime_fees_billed,
+    sum(payment_amount) AS lifetime_fees_paid,
+    avg(net_fee) AS average_invoice_amount,
+    sum(
+        CASE
+            WHEN ((calculation_status)::text = ANY ((ARRAY['INVOICED'::character varying, 'PARTIALLY_PAID'::character varying])::text[])) THEN (net_fee - COALESCE(payment_amount, (0)::numeric))
+            ELSE (0)::numeric
+        END) AS current_balance_due,
+    max(billing_period_end) AS last_billing_date,
+    avg(
+        CASE
+            WHEN (payment_received_at IS NOT NULL) THEN EXTRACT(day FROM (payment_received_at - invoice_sent_at))
+            ELSE NULL::numeric
+        END) AS avg_days_to_payment
+   FROM public.fee_calculations fc
+  WHERE ((calculation_status)::text <> 'DRAFT'::text)
+  GROUP BY client_id;
