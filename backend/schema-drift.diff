+--
+-- Name: active_datasource_lookups; Type: VIEW; Schema: public; Owner: -
+--
+
+CREATE VIEW public.active_datasource_lookups AS
+ SELECT dl.id,
+    dl.datasource_id,
+    dl.lookup_id,
+    dl.tenant_id,
+    l.name AS lookup_name,
+    l.description AS lookup_description,
+    l.source_table,
+    tpd.source_name AS datasource_source_name,
+    tpd.environment,
+    dl.is_active,
+    dl.sync_enabled,
+    dl.last_sync_at,
+    dl.last_sync_status,
+    dl.sync_lag_seconds,
+    dl.purpose
+   FROM ((public.datasource_lookups dl
+     JOIN public.lookups l ON ((dl.lookup_id = l.id)))
+     JOIN public.tenant_product_datasource tpd ON ((dl.datasource_id = tpd.id)))
+  WHERE ((dl.is_active = true) AND (tpd.is_active = true))
+  ORDER BY dl.created_at;
+
