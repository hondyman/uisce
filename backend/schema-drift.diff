+--
+-- Name: semantic_aggregate_health; Type: VIEW; Schema: public; Owner: -
+--
+
+CREATE VIEW public.semantic_aggregate_health AS
+ WITH latest_stat AS (
+         SELECT DISTINCT ON (semantic_aggregate_build_stats.semantic_aggregate_id) semantic_aggregate_build_stats.semantic_aggregate_id,
+            semantic_aggregate_build_stats.build_status,
+            semantic_aggregate_build_stats.row_count,
+            semantic_aggregate_build_stats.bytes_processed,
+            semantic_aggregate_build_stats.duration_ms,
+            semantic_aggregate_build_stats.source_watermark,
+            semantic_aggregate_build_stats.built_at
+           FROM public.semantic_aggregate_build_stats
+          ORDER BY semantic_aggregate_build_stats.semantic_aggregate_id, semantic_aggregate_build_stats.built_at DESC
+        ), error_streak AS (
+         SELECT semantic_aggregate_build_stats.semantic_aggregate_id,
+            count(*) FILTER (WHERE (semantic_aggregate_build_stats.build_status = 'failed'::text)) AS failed_builds_7d
+           FROM public.semantic_aggregate_build_stats
+          WHERE (semantic_aggregate_build_stats.built_at >= (now() - '7 days'::interval))
+          GROUP BY semantic_aggregate_build_stats.semantic_aggregate_id
+        )
+ SELECT sar.id AS semantic_aggregate_id,
+    sar.tenant_id,
+    sar.datasource_id,
+    sar.business_object_id,
+    sar.metric_id,
+    sar.aggregate_name,
+    sar.status AS registry_status,
+    sar.freshness_sla_seconds,
+    ls.build_status AS last_build_status,
+    ls.row_count AS last_row_count,
+    ls.bytes_processed AS last_bytes_processed,
+    ls.duration_ms AS last_duration_ms,
+    ls.source_watermark AS last_source_watermark,
+    ls.built_at AS last_built_at,
+    COALESCE(es.failed_builds_7d, (0)::bigint) AS failed_builds_7d,
+        CASE
+            WHEN (sar.freshness_sla_seconds IS NULL) THEN true
+            WHEN (ls.built_at IS NULL) THEN false
+            ELSE (EXTRACT(epoch FROM (now() - ls.built_at)) <= (sar.freshness_sla_seconds)::numeric)
+        END AS is_fresh
+   FROM ((public.semantic_aggregate_registry sar
+     LEFT JOIN latest_stat ls ON ((ls.semantic_aggregate_id = sar.id)))
+     LEFT JOIN error_streak es ON ((es.semantic_aggregate_id = sar.id)));
+
+
