+--
+-- Name: get_entity_translations(character varying, character varying, uuid, character varying); Type: FUNCTION; Schema: public; Owner: -
+--
+
+CREATE FUNCTION public.get_entity_translations(p_context character varying, p_entity_type character varying, p_entity_id uuid, p_key character varying DEFAULT NULL::character varying) RETURNS jsonb
+    LANGUAGE plpgsql STABLE
+    AS $$
+BEGIN
+  IF p_key IS NULL THEN
+    -- Return all translations for the entity grouped by key
+    RETURN (
+      SELECT jsonb_object_agg(key, jsonb_object_agg(language_code, value))
+      FROM (
+        SELECT key, language_code, value
+        FROM public.translations
+        WHERE context = p_context
+          AND entity_type = p_entity_type
+          AND entity_id = p_entity_id
+        ORDER BY key, language_code
+      ) t
+    );
+  ELSE
+    -- Return translations for specific key grouped by language
+    RETURN (
+      SELECT jsonb_object_agg(language_code, value)
+      FROM public.translations
+      WHERE context = p_context
+        AND entity_type = p_entity_type
+        AND entity_id = p_entity_id
+        AND key = p_key
+    );
+  END IF;
+END;
+$$;
+
