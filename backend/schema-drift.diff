+--
+-- Name: abac_policies; Type: VIEW; Schema: security; Owner: -
+--
+
+CREATE VIEW security.abac_policies AS
+ SELECT id AS policy_id,
+    tenant_id,
+    COALESCE((subject_rules ->> 'role'::text), (subject_rules ->> 'profile_key'::text), (subject_rules ->> 'profile'::text)) AS target_profile_key,
+    COALESCE((action_rules ->> 'action'::text), (action_rules ->> 'action_attribute'::text)) AS action_attribute,
+    (jsonb_build_object('subject_rules', subject_rules, 'action_rules', action_rules, 'resource_rules', resource_rules, 'environment_rules', environment_rules, 'mandatory_filters', mandatory_filters))::text AS condition_dsl,
+    (effect)::character varying(10) AS effect,
+    priority AS priority_rank
+   FROM public.abac_policies
+  WHERE (enabled = true);
+
+
+--
+-- Name: VIEW abac_policies; Type: COMMENT; Schema: security; Owner: -
+--
+
+COMMENT ON VIEW security.abac_policies IS 'Spec-shaped projection of public.abac_policies. The write path remains public.abac_policies (with JSONB rule blobs); this view flattens the JSONB into the spec columns (target_profile_key, action_attribute, condition_dsl, priority_rank) for queryability. Cardinal Rule 1: canonical data stays in public.abac_policies.';
+
