+--
+-- Name: is_business_day(character varying, date); Type: FUNCTION; Schema: public; Owner: -
+--
+
+CREATE FUNCTION public.is_business_day(p_calendar_code character varying, p_date date) RETURNS boolean
+    LANGUAGE plpgsql STABLE
+    AS $$
+DECLARE
+    v_calendar_id UUID;
+    v_weekend_days INTEGER[];
+    v_day_of_week INTEGER;
+    v_is_holiday BOOLEAN;
+    v_region VARCHAR;
+    v_exchange VARCHAR;
+    v_mdm_result BOOLEAN;
+BEGIN
+    -- 1. Check if we have an MDM mapping for this calendar
+    SELECT region_code, exchange_code, calendar_id, weekend_days 
+    INTO v_region, v_exchange, v_calendar_id, v_weekend_days
+    FROM business_calendars
+    WHERE calendar_code = p_calendar_code AND active = TRUE;
+    
+    IF v_calendar_id IS NULL THEN
+        -- Fallback: if we can't find it in business_calendars, try a default mapping or error
+        RETURN NULL; -- Or raise exception
+    END IF;
+
+    -- 2. Try MDM lookup if mapping exists
+    IF v_region IS NOT NULL THEN
+        SELECT is_business_day INTO v_mdm_result
+        FROM edm.mdm_calendar_golden
+        WHERE tenant_id = COALESCE(current_setting('app.current_tenant_id', TRUE)::UUID, '00000000-0000-0000-0000-000000000001'::UUID)
+        AND region_code = v_region
+        AND (v_exchange IS NULL OR exchange_code = v_exchange)
+        AND calendar_date = p_date
+        ORDER BY confidence_score DESC
+        LIMIT 1;
+
+        IF FOUND THEN
+            RETURN v_mdm_result;
+        END IF;
+    END IF;
+
+    -- 3. Fallback to legacy logic: Check weekend
+    v_day_of_week := EXTRACT(DOW FROM p_date);
+    IF v_day_of_week = ANY(v_weekend_days) THEN
+        RETURN FALSE;
+    END IF;
+    
+    -- 4. Fallback to legacy logic: Check if holiday
+    WITH RECURSIVE calendar_hierarchy AS (
+        SELECT calendar_id FROM business_calendars WHERE calendar_id = v_calendar_id
+        UNION
+        SELECT unnest(parent_calendar_ids) 
+        FROM business_calendars bc
+        JOIN calendar_hierarchy ch ON bc.calendar_id = ch.calendar_id
+        WHERE bc.parent_calendar_ids IS NOT NULL
+    )
+    SELECT EXISTS(
+        SELECT 1 FROM calendar_holidays
+        WHERE calendar_id IN (SELECT calendar_id FROM calendar_hierarchy)
+        AND holiday_date = p_date
+    ) INTO v_is_holiday;
+    
+    RETURN NOT v_is_holiday;
+END;
+$$;
+
+
+--
+-- Name: FUNCTION is_business_day(p_calendar_code character varying, p_date date); Type: COMMENT; Schema: public; Owner: -
+--
+
+COMMENT ON FUNCTION public.is_business_day(p_calendar_code character varying, p_date date) IS 'Check if a date is a business day considering weekends and holidays (with inheritance)';
+
+
+--
+-- Name: is_business_day(uuid, character varying, date); Type: FUNCTION; Schema: public; Owner: -
+--
+
+CREATE FUNCTION public.is_business_day(p_tenant_id uuid, p_calendar_code character varying, p_date date) RETURNS boolean
+    LANGUAGE plpgsql STABLE
+    AS $$
+DECLARE
+    v_calendar_id UUID;
+    v_region VARCHAR;
+    v_exchange VARCHAR;
+    v_mdm_result BOOLEAN;
+    v_weekend_days INTEGER[];
+    v_day_of_week INTEGER;
+    v_is_holiday BOOLEAN;
+    v_parent_ids UUID[];
+    v_parent_code VARCHAR;
+    v_all_parents_open BOOLEAN := TRUE;
+    v_threshold INTEGER := 75;
+BEGIN
+    -- 0. Set session context for RLS if policy exists
+    PERFORM set_config('app.current_tenant_id', p_tenant_id::text, true);
+    PERFORM set_config('row_security', 'off', true);
+    
+    -- 1. Get calendar metadata and threshold
+    SELECT region_code, exchange_code, calendar_id, weekend_days, parent_calendar_ids
+    INTO v_region, v_exchange, v_calendar_id, v_weekend_days, v_parent_ids
+    FROM public.business_calendars
+    WHERE calendar_code = p_calendar_code 
+    AND (tenant_id = p_tenant_id OR is_global = TRUE)
+    AND active = TRUE
+    ORDER BY is_global ASC -- Prefer tenant-specific if both exist
+    LIMIT 1;
+    
+    IF v_calendar_id IS NULL THEN
+        RETURN NULL;
+    END IF;
+
+    SELECT threshold_score INTO v_threshold
+    FROM public.calendar_confidence_thresholds
+    WHERE tenant_id = p_tenant_id;
+    
+    v_threshold := COALESCE(v_threshold, 75);
+
+    -- 2. Try MDM lookup (Tenant-scoped)
+    IF v_region IS NOT NULL THEN
+        SELECT g.is_business_day INTO v_mdm_result
+        FROM edm.mdm_calendar_golden g
+        WHERE g.tenant_id = p_tenant_id
+        AND g.region_code = v_region
+        AND (v_exchange IS NULL OR g.exchange_code = v_exchange)
+        AND g.calendar_date = p_date
+        AND g.confidence_score >= v_threshold
+        AND (g.valid_to IS NULL OR g.valid_to > NOW())
+        ORDER BY g.confidence_score DESC
+        LIMIT 1;
+
+        IF FOUND THEN
+            RETURN v_mdm_result;
+        END IF;
+    END IF;
+
+    -- 3. Check Parent Composition (Intersection logic: business day if ALL parents are open)
+    -- This handles the "NYSE ∩ Fed Holidays" pattern
+    IF v_parent_ids IS NOT NULL AND array_length(v_parent_ids, 1) > 0 THEN
+        FOR v_calendar_id IN SELECT unnest(v_parent_ids) LOOP
+            SELECT calendar_code INTO v_parent_code FROM business_calendars WHERE calendar_id = v_calendar_id;
+            IF NOT is_business_day(p_tenant_id, v_parent_code, p_date) THEN
+                v_all_parents_open := FALSE;
+                EXIT;
+            END IF;
+        END LOOP;
+        
+        IF NOT v_all_parents_open THEN
+            RETURN FALSE;
+        END IF;
+    END IF;
+
+    -- 4. Fallback: Region-aware weekend rules
+    v_day_of_week := EXTRACT(DOW FROM p_date);
+    
+    -- Handle Middle Eastern Fri/Sat weekends
+    IF v_region IN ('SA', 'AE', 'QA', 'BH', 'OM', 'KW', 'IL', 'ME') THEN
+        IF v_day_of_week IN (5, 6) THEN RETURN FALSE; END IF;
+    ELSE
+        -- Default Sat/Sun
+        IF v_day_of_week IN (0, 6) THEN RETURN FALSE; END IF;
+    END IF;
+
+    -- 5. Fallback: Holiday table
+    SELECT EXISTS(
+        SELECT 1 FROM calendar_holidays
+        WHERE calendar_id = v_calendar_id
+        AND holiday_date = p_date
+    ) INTO v_is_holiday;
+    
+    RETURN NOT v_is_holiday;
+END;
+$$;
+
