+--
+-- Name: next_scheduled_jobs; Type: VIEW; Schema: edm; Owner: -
+--
+
+CREATE VIEW edm.next_scheduled_jobs AS
+ SELECT id,
+    tenant_id,
+    operation_type,
+    next_run_at,
+    schedule_type,
+    cron_expression,
+    timezone,
+    priority,
+    job_template,
+    (EXTRACT(epoch FROM ((next_run_at)::timestamp with time zone - now())))::integer AS seconds_until_run,
+    run_count,
+    success_count,
+    failure_count
+   FROM edm.scheduled_jobs j
+  WHERE (((status)::text = 'active'::text) AND (is_active = true) AND (next_run_at <= (now() + '00:01:00'::interval)))
+  ORDER BY priority DESC, next_run_at;
+
