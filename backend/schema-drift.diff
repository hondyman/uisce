+--
+-- Name: get_all_bo_fields(uuid); Type: FUNCTION; Schema: public; Owner: -
+--
+
+CREATE FUNCTION public.get_all_bo_fields(bo_id uuid) RETURNS TABLE(field_id uuid, field_key character varying, field_name character varying, field_type character varying, is_core boolean, is_required boolean, is_custom boolean, is_inherited boolean, inherited_from character varying, sequence integer)
+    LANGUAGE plpgsql
+    AS $$
+BEGIN
+    RETURN QUERY
+    WITH RECURSIVE bo_hierarchy AS (
+        -- Start with the current BO
+        SELECT id, parent_id, bo_key, 0 AS level
+        FROM public.business_objects
+        WHERE id = bo_id
+        
+        UNION ALL
+        
+        -- Recursively get parent BOs
+        SELECT bo.id, bo.parent_id, bo.bo_key, bh.level + 1
+        FROM public.business_objects bo
+        INNER JOIN bo_hierarchy bh ON bo.id = bh.parent_id
+    )
+    SELECT 
+        f.id AS field_id,
+        f.key AS field_key,
+        f.name AS field_name,
+        f.type AS field_type,
+        f.is_core,
+        f.is_required,
+        f.is_custom,
+        CASE WHEN f.business_object_id != bo_id THEN true ELSE false END AS is_inherited,
+        CASE WHEN f.business_object_id != bo_id THEN bh.key ELSE NULL END AS inherited_from,
+        f.sequence
+    FROM bo_hierarchy bh
+    INNER JOIN public.bo_fields f ON f.business_object_id = bh.id
+    WHERE f.subtype_id IS NULL
+    ORDER BY bh.level DESC, f.sequence ASC;
+END;
+$$;
