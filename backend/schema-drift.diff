+--
+-- Name: v_liquidity_needs_projection; Type: MATERIALIZED VIEW; Schema: public; Owner: -
+--
+
+CREATE MATERIALIZED VIEW public.v_liquidity_needs_projection AS
+ SELECT tenant_id,
+    (date_trunc('month'::text, (forecast_date)::timestamp with time zone))::date AS month,
+    scenario,
+    count(*) AS fund_count,
+    sum(projected_calls) AS total_calls,
+    sum(projected_distributions) AS total_distributions,
+    (sum(projected_calls) - sum(projected_distributions)) AS net_needs,
+    sum(p95_percentile) AS max_probable_calls_95th
+   FROM public.cash_flow_forecasts
+  WHERE ((forecast_date >= CURRENT_DATE) AND (forecast_date <= (CURRENT_DATE + '2 years'::interval)))
+  GROUP BY tenant_id, (date_trunc('month'::text, (forecast_date)::timestamp with time zone)), scenario
+  WITH NO DATA;
+
+
+--
+-- Name: v_pipeline_summary; Type: VIEW; Schema: public; Owner: -
+--
+
+CREATE VIEW public.v_pipeline_summary AS
+ SELECT current_stage,
+    opportunity_type,
+    count(*) AS opportunity_count,
+    sum(target_commitment) AS total_commitment,
+    (avg(EXTRACT(day FROM (now() - created_at))))::integer AS avg_days_in_pipeline,
+    min(created_at) AS oldest_opportunity
+   FROM public.investment_opportunities
+  WHERE ((current_stage)::text <> ALL ((ARRAY['CLOSED_WON'::character varying, 'CLOSED_LOST'::character varying])::text[]))
+  GROUP BY current_stage, opportunity_type
+  ORDER BY
+        CASE current_stage
+            WHEN 'INTAKE'::text THEN 1
+            WHEN 'INITIAL_SCREEN'::text THEN 2
+            WHEN 'DUE_DILIGENCE'::text THEN 3
+            WHEN 'INVESTMENT_COMMITTEE'::text THEN 4
+            WHEN 'APPROVED'::text THEN 5
+            WHEN 'DOCUMENTATION'::text THEN 6
+            WHEN 'COMMITTED'::text THEN 7
+            WHEN 'FUNDED'::text THEN 8
+            ELSE 9
+        END;
+
