+
+CREATE FUNCTION public.search_data_domains(search_term text, p_tenant_id uuid) RETURNS SETOF public.data_domains
+    LANGUAGE plpgsql
+    AS $$
+		BEGIN
+			RETURN QUERY
+			SELECT *
+			FROM public.data_domains
+			WHERE
+				(p_tenant_id IS NULL OR tenant_id = p_tenant_id) AND
+				(name ILIKE '%' || search_term || '%' OR description ILIKE '%' || search_term || '%')
+			ORDER BY level, name
+			LIMIT 20;
+		END; $$;
