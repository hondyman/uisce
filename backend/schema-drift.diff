+--
+
+COMMENT ON TABLE public.alternative_performance_fee_calculations IS 'Tracks performance fee (carried interest) calculations for alternative investments.
+Formula: If total_value > total_called * (1 + hurdle_rate), then:
+  - LP gets total_called * hurdle_rate first
+  - GP catches up via catch_up_rate
