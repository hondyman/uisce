+--
+-- Name: client_alt_allocation; Type: VIEW; Schema: public; Owner: -
+--
+
+CREATE VIEW public.client_alt_allocation AS
+ WITH type_stats AS (
+         SELECT alternative_investments.client_id,
+            alternative_investments.investment_type,
+            count(*) AS type_count,
+            sum(alternative_investments.current_nav) AS type_nav
+           FROM public.alternative_investments
+          GROUP BY alternative_investments.client_id, alternative_investments.investment_type
+        ), overall_stats AS (
+         SELECT alternative_investments.client_id,
+            count(*) AS total_investments,
+            sum(alternative_investments.total_commitment_amount) AS total_committed,
+            sum(alternative_investments.unfunded_commitment) AS total_unfunded,
+            sum(alternative_investments.total_capital_called) AS total_called,
+            sum(alternative_investments.current_nav) AS total_current_value,
+            sum(alternative_investments.total_distributions) AS total_distributions_received,
+            avg(alternative_investments.irr_since_inception) AS avg_irr,
+            avg(alternative_investments.tvpi) AS avg_tvpi
+           FROM public.alternative_investments
+          GROUP BY alternative_investments.client_id
+        )
+ SELECT client_id,
+    total_investments,
+    total_committed,
+    total_unfunded,
+    total_called,
+    total_current_value,
+    total_distributions_received,
+    avg_irr,
+    avg_tvpi,
+    ( SELECT jsonb_object_agg(t.investment_type, jsonb_build_object('count', t.type_count, 'total_nav', t.type_nav)) AS jsonb_object_agg
+           FROM type_stats t
+          WHERE (t.client_id = o.client_id)) AS allocation_by_type
+   FROM overall_stats o;
+
