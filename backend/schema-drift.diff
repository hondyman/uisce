+    has_catch_up boolean DEFAULT true,
+    catch_up_rate numeric(5,4),
+    has_high_water_mark boolean DEFAULT false,
+    management_fee_frequency character varying(20) DEFAULT 'QUARTERLY'::character varying,
+    performance_fee_timing character varying(50) DEFAULT 'ON_DISTRIBUTION'::character varying,
+    has_clawback boolean DEFAULT true,
