+    job_template jsonb NOT NULL,
+    schedule_type character varying(20) NOT NULL,
+    start_time timestamp without time zone NOT NULL,
+    end_time timestamp without time zone,
+    cron_expression character varying(255),
+    timezone character varying(50) DEFAULT 'UTC'::character varying,
+    max_run_duration integer,
+    retry_on_failure boolean DEFAULT true,
+    max_retries integer DEFAULT 3,
+    status character varying(20) DEFAULT 'active'::character varying NOT NULL,
+    is_active boolean DEFAULT true,
+    last_run_at timestamp without time zone,
+    last_run_status character varying(20),
+    last_run_error text,
+    next_run_at timestamp without time zone,
+    run_count integer DEFAULT 0,
+    success_count integer DEFAULT 0,
+    failure_count integer DEFAULT 0,
+    name character varying(500),
+    description text,
+    priority integer DEFAULT 10,
+    created_by uuid NOT NULL,
+    created_at timestamp without time zone DEFAULT now() NOT NULL,
+    updated_at timestamp without time zone DEFAULT now() NOT NULL,
+    CONSTRAINT valid_operation_type CHECK (((operation_type)::text = ANY ((ARRAY['bulk-create'::character varying, 'bulk-publish'::character varying, 'bulk-promote'::character varying])::text[]))),
+    CONSTRAINT valid_sched_status CHECK (((status)::text = ANY ((ARRAY['active'::character varying, 'paused'::character varying, 'completed'::character varying, 'failed'::character varying, 'disabled'::character varying])::text[]))),
+    CONSTRAINT valid_schedule_type CHECK (((schedule_type)::text = ANY ((ARRAY['once'::character varying, 'daily'::character varying, 'weekly'::character varying, 'monthly'::character varying, 'cron'::character varying])::text[])))
+);
