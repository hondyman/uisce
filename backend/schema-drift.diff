+--
+-- Name: adjust_date(character varying, date, public.adjustment_convention); Type: FUNCTION; Schema: public; Owner: -
+--
+
+CREATE FUNCTION public.adjust_date(p_calendar_code character varying, p_date date, p_convention public.adjustment_convention) RETURNS date
+    LANGUAGE plpgsql STABLE
+    AS $$
+DECLARE
+    v_adjusted DATE := p_date;
+    v_month INTEGER := EXTRACT(MONTH FROM p_date);
+BEGIN
+    IF p_convention = 'UNADJUSTED' THEN
+        RETURN p_date;
+    END IF;
+
+    IF is_business_day(p_calendar_code, p_date) THEN
+        RETURN p_date;
+    END IF;
+
+    IF p_convention = 'FOLLOWING' OR p_convention = 'MODIFIED_FOLLOWING' THEN
+        v_adjusted := next_business_day(p_calendar_code, p_date - 1);
+        IF p_convention = 'MODIFIED_FOLLOWING' AND EXTRACT(MONTH FROM v_adjusted) != v_month THEN
+            v_adjusted := previous_business_day(p_calendar_code, p_date + 1);
+        END IF;
+    ELSIF p_convention = 'PRECEDING' THEN
+        v_adjusted := previous_business_day(p_calendar_code, p_date + 1);
+    END IF;
+
+    RETURN v_adjusted;
+END;
+$$;
+
+
