+--
+-- Name: alt_investment_performance; Type: VIEW; Schema: public; Owner: -
+--
+
+CREATE VIEW public.alt_investment_performance AS
+ SELECT investment_id,
+    client_id,
+    fund_name,
+    investment_type,
+    vintage_year,
+    total_commitment_amount,
+    unfunded_commitment,
+    total_capital_called,
+    total_distributions,
+    current_nav,
+    nav_date,
+    irr_since_inception,
+    tvpi,
+    dpi,
+    rvpi,
+    moic,
+    (total_capital_called - total_distributions) AS net_cash_flow,
+    ((current_nav + total_distributions) / NULLIF(total_capital_called, (0)::numeric)) AS total_value_multiple,
+    ((unfunded_commitment / NULLIF(total_commitment_amount, (0)::numeric)) * (100)::numeric) AS pct_unfunded
+   FROM public.alternative_investments ai;
+
+
+--
+-- Name: alt_investments_performance_summary; Type: VIEW; Schema: public; Owner: -
+--
+
+CREATE VIEW public.alt_investments_performance_summary AS
+ SELECT ai.investment_id,
+    COALESCE(ai.fund_name, ''::text) AS fund_name,
+    ai.asset_class,
+    ai.vintage_year,
+    (0)::numeric AS commitment_amount,
+    (0)::numeric AS funded_amount,
+    COALESCE(ai.unfunded_commitment, (0)::numeric) AS unfunded_commitment,
+    ((ai.performance_metrics ->> 'irr'::text))::numeric AS irr,
+    ((ai.performance_metrics ->> 'moic'::text))::numeric AS moic,
+    ((ai.performance_metrics ->> 'tvpi'::text))::numeric AS tvpi,
+    ((ai.performance_metrics ->> 'dpi'::text))::numeric AS dpi,
+    ((ai.performance_metrics ->> 'rvpi'::text))::numeric AS rvpi,
+    b.pme_kaplan_schoar,
+    b.fund_percentile_rank,
+    'UNKNOWN'::text AS j_curve_position,
+    ai.current_nav
+   FROM (public.alternative_investments ai
+     LEFT JOIN public.alt_investment_benchmarks b ON ((ai.investment_id = b.investment_id)));
+
