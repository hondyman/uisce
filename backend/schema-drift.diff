+--
+-- Name: fee_calc_pending_approval; Type: VIEW; Schema: public; Owner: -
+--
+
+CREATE VIEW public.fee_calc_pending_approval AS
+ SELECT fc.calculation_id,
+    fc.client_id,
+    fc.billing_period_start,
+    fc.billing_period_end,
+    fc.net_fee,
+    fc.requires_manual_review,
+    fc.review_notes,
+    fc.created_at,
+    cfa.schedule_id,
+    fs.schedule_name
+   FROM ((public.fee_calculations fc
+     LEFT JOIN public.client_fee_assignments cfa ON ((fc.assignment_id = cfa.assignment_id)))
+     LEFT JOIN public.fee_schedules fs ON ((cfa.schedule_id = fs.schedule_id)))
+  WHERE (((fc.calculation_status)::text = 'PENDING_REVIEW'::text) OR (fc.requires_manual_review = true))
+  ORDER BY fc.created_at;
+
