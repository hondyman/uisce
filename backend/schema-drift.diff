+-- Name: next_business_day(character varying, date); Type: FUNCTION; Schema: public; Owner: -
+--
+
+CREATE FUNCTION public.next_business_day(p_calendar_code character varying, p_from_date date) RETURNS date
+    LANGUAGE plpgsql STABLE
+    AS $$
+DECLARE
+    v_current DATE := p_from_date + 1;
+    v_iterations INTEGER := 0;
+BEGIN
+    WHILE v_iterations < 366 LOOP
+        IF is_business_day(p_calendar_code, v_current) THEN
+            RETURN v_current;
+        END IF;
+        v_current := v_current + 1;
+        v_iterations := v_iterations + 1;
+    END LOOP;
+    RAISE EXCEPTION 'Could not find next business day within a year';
+END;
+$$;
+
