+--
+-- Name: ops_incidents_by_region; Type: VIEW; Schema: public; Owner: -
+--
+
+CREATE VIEW public.ops_incidents_by_region AS
+ SELECT region,
+    count(*) AS total_incidents,
+    count(
+        CASE
+            WHEN (status = 'open'::text) THEN 1
+            ELSE NULL::integer
+        END) AS open_incidents,
+    count(
+        CASE
+            WHEN (status = 'closed'::text) THEN 1
+            ELSE NULL::integer
+        END) AS closed_incidents,
+    max(severity) AS max_severity,
+    max(started_at) AS latest_incident
+   FROM public.ops_incidents
+  WHERE (started_at > (CURRENT_TIMESTAMP - '24:00:00'::interval))
+  GROUP BY region;
+
