+--
+-- Name: v_column_primary_match; Type: VIEW; Schema: vend; Owner: -
+--
+
+CREATE VIEW vend.v_column_primary_match AS
+ SELECT r.column_id,
+    r.database_name,
+    r.schema_name,
+    r.table_name,
+    r.column_name,
+    r.data_type,
+    m.term_id,
+    g.canonical_name,
+    g.term_type,
+    g.definition_clean,
+    s.source_key,
+    m.match_method,
+    m.match_score,
+    m.curator_reviewed,
+    m.curator_approved
+   FROM (((vend.db_column_registry r
+     JOIN vend.glossary_match m ON (((m.column_id = r.column_id) AND (m.is_primary = true))))
+     JOIN vend.glossary_term g ON ((g.term_id = m.term_id)))
+     JOIN vend.dictionary_source s ON ((s.source_id = g.source_id)));
+
+
+--
+-- Name: v_glossary_current; Type: VIEW; Schema: vend; Owner: -
+--
+
+CREATE VIEW vend.v_glossary_current AS
+ SELECT g.term_id,
+    g.source_id,
+    g.version_id,
+    g.raw_id,
+    g.canonical_name,
+    g.name_slug,
+    g.name_tokens,
+    g.term_type,
+    g.term_subtype,
+    g.domain_ontology,
+    g.definition,
+    g.definition_clean,
+    g.generated_definition,
+    g.synonyms,
+    g.examples,
+    g.explanations,
+    g.source_uri,
+    g.source_ontology,
+    g.maturity,
+    g.embedding,
+    g.embedding_model,
+    g.content_hash,
+    g.first_seen_at,
+    g.last_updated_at,
+    g.is_current,
+    s.source_key
+   FROM (vend.glossary_term g
+     JOIN vend.dictionary_source s ON ((s.source_id = g.source_id)))
+  WHERE (g.is_current = true);
+
