+--
+-- Name: metric_registry_with_stats; Type: VIEW; Schema: semantic; Owner: -
+--
+
+CREATE VIEW semantic.metric_registry_with_stats AS
+ SELECT r.metric_id,
+    r.name,
+    r.display_name,
+    r.description,
+    r.domain,
+    r.category,
+    r.metric_type,
+    r.base_query,
+    r.aggregation_function,
+    r.granularity,
+    r.value_column,
+    r.date_column,
+    r.source_formula,
+    r.source_system,
+    r.comparison_periods,
+    r.period_label_format,
+    r.sla_freshness_hours,
+    r.sla_completeness_threshold,
+    r.refresh_schedule,
+    r.owner_user_id,
+    r.steward_group,
+    r.golden_path,
+    r.status,
+    r.version,
+    r.created_at,
+    r.updated_at,
+    r.created_by,
+    r.updated_by,
+    el.status AS last_execution_status,
+    el.completed_at AS last_execution_time,
+    el.completeness_score AS last_completeness,
+    el.error_count AS last_error_count,
+        CASE
+            WHEN (el.completed_at IS NULL) THEN 'never_executed'::text
+            WHEN ((now() - el.completed_at) <= '1 day'::interval) THEN 'fresh'::text
+            WHEN ((now() - el.completed_at) <= '7 days'::interval) THEN 'stale'::text
+            ELSE 'very_stale'::text
+        END AS execution_freshness
+   FROM (semantic.metric_registry r
+     LEFT JOIN semantic.metric_execution_log el ON (((r.metric_id = el.metric_id) AND (el.execution_id = ( SELECT metric_execution_log.execution_id
+           FROM semantic.metric_execution_log
+          WHERE (metric_execution_log.metric_id = r.metric_id)
+          ORDER BY metric_execution_log.completed_at DESC NULLS LAST
+         LIMIT 1)))));
+
