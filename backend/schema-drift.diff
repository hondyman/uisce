+--
+-- Name: to_slug(text); Type: FUNCTION; Schema: vend; Owner: -
+--
+
+CREATE FUNCTION vend.to_slug(input_text text) RETURNS text
+    LANGUAGE plpgsql IMMUTABLE
+    AS $$
+DECLARE
+    result TEXT;
+BEGIN
+    result := lower(input_text);
+    result := regexp_replace(result, '([a-z0-9])([A-Z])', '\1_\2', 'g');
+    result := regexp_replace(result, '[^a-z0-9]+', '_', 'g');
+    result := regexp_replace(result, '_+', '_', 'g');
+    result := trim(both '_' from result);
+    RETURN result;
+END;
+$$;
+
+
+--
+-- Name: tokenize(text); Type: FUNCTION; Schema: vend; Owner: -
+--
+
+CREATE FUNCTION vend.tokenize(input_text text) RETURNS text[]
+    LANGUAGE plpgsql IMMUTABLE
+    AS $$
+DECLARE
+    result TEXT[];
+BEGIN
+    SELECT array_agg(DISTINCT w ORDER BY w)
+    INTO result
+    FROM regexp_split_to_table(
+        lower(regexp_replace(input_text, '[^a-zA-Z0-9]+', ' ', 'g')),
+        ' '
+    ) AS w
+    WHERE length(w) > 1;
+    RETURN COALESCE(result, ARRAY[]::TEXT[]);
+END;
+$$;
+
