+--
+-- Name: recent_exports; Type: VIEW; Schema: edm; Owner: -
+--
+
+CREATE VIEW edm.recent_exports AS
+ SELECT id,
+    job_id,
+    tenant_id,
+    export_format,
+    status,
+    file_size,
+    record_count,
+    created_at,
+    completed_at,
+    (EXTRACT(epoch FROM (completed_at - created_at)))::integer AS duration_seconds,
+        CASE
+            WHEN (expires_at > now()) THEN true
+            ELSE false
+        END AS is_available
+   FROM edm.job_exports e
+  WHERE ((status)::text = ANY ((ARRAY['completed'::character varying, 'processing'::character varying])::text[]))
+  ORDER BY created_at DESC;
