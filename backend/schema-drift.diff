+CREATE FUNCTION public.business_days_between(p_tenant_id uuid, p_calendar_code character varying, p_start_date date, p_end_date date) RETURNS integer
+    LANGUAGE plpgsql STABLE
+    AS $$
+DECLARE
+    v_count INTEGER := 0;
+    v_current DATE;
+BEGIN
+    IF p_start_date > p_end_date THEN
+        RETURN -business_days_between(p_tenant_id, p_calendar_code, p_end_date, p_start_date);
+    END IF;
+
+    FOR v_current IN SELECT generate_series(p_start_date, p_end_date, '1 day'::interval)::date LOOP
+        IF is_business_day(p_tenant_id, p_calendar_code, v_current) THEN
+            v_count := v_count + 1;
+        END IF;
+    END LOOP;
+    RETURN v_count;
+END;
+$$;
