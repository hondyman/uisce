+--
+-- Name: sync_lookup_to_datasource(uuid, uuid, text); Type: FUNCTION; Schema: public; Owner: -
+--
+
+CREATE FUNCTION public.sync_lookup_to_datasource(p_datasource_id uuid, p_lookup_id uuid, p_triggered_by text DEFAULT 'system'::text) RETURNS TABLE(sync_history_id uuid, status text, message text)
+    LANGUAGE plpgsql
+    AS $$
+DECLARE
+    v_datasource_lookup_id UUID;
+    v_sync_history_id UUID;
+    v_tenant_id UUID;
+BEGIN
+    -- Find the linkage
+    SELECT id, tenant_id INTO v_datasource_lookup_id, v_tenant_id
+    FROM public.datasource_lookups
+    WHERE datasource_id = p_datasource_id AND lookup_id = p_lookup_id;
+    
+    IF v_datasource_lookup_id IS NULL THEN
+        RETURN QUERY SELECT 
+            NULL::UUID, 
+            'failed', 
+            'Lookup not linked to datasource'::TEXT;
+        RETURN;
+    END IF;
+    
+    -- Create sync history record
+    INSERT INTO public.datasource_lookup_sync_history (
+        datasource_lookup_id, sync_type, status, triggered_by, correlation_id
+    ) VALUES (
+        v_datasource_lookup_id, 'incremental', 'pending', p_triggered_by, 
+        gen_random_uuid()::text
+    )
+    RETURNING datasource_lookup_sync_history.id INTO v_sync_history_id;
+    
+    -- Update last sync timestamp
+    UPDATE public.datasource_lookups
+    SET last_sync_at = NOW(), last_sync_status = 'pending'
+    WHERE id = v_datasource_lookup_id;
+    
+    RETURN QUERY SELECT 
+        v_sync_history_id, 
+        'pending'::TEXT, 
+        'Sync queued'::TEXT;
+END;
+$$;
+
