+--
+-- Name: bo_validation_event_analytics; Type: MATERIALIZED VIEW; Schema: public; Owner: -
+--
+
+CREATE MATERIALIZED VIEW public.bo_validation_event_analytics AS
+ SELECT (workflow_audit_log.tenant_id)::text AS tenant_id,
+    workflow_audit_log.actor_id,
+    workflow_audit_log.created_at,
+    workflow_audit_log.event_type,
+    COALESCE((workflow_audit_log.metadata ->> 'bo_name'::text), ''::text) AS bo_name,
+    COALESCE((workflow_audit_log.metadata ->> 'event_id'::text), ''::text) AS event_id,
+    COALESCE(((workflow_audit_log.metadata ->> 'passed'::text))::boolean, false) AS passed,
+    (failure.value ->> 'rule_id'::text) AS rule_id,
+    (failure.value ->> 'rule_name'::text) AS rule_name,
+    (failure.value ->> 'field_key'::text) AS field_key,
+    (failure.value ->> 'message'::text) AS message,
+    (failure.value ->> 'source'::text) AS source
+   FROM (public.workflow_audit_log
+     LEFT JOIN LATERAL jsonb_array_elements(COALESCE((workflow_audit_log.metadata -> 'validation_failures'::text), '[]'::jsonb)) failure(value) ON (true))
+  WHERE (workflow_audit_log.event_type = 'bo_validation_event'::text)
+  WITH NO DATA;
+
