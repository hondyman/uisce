+CREATE VIEW calendar.profile_calendar_summary AS
+ SELECT sp.id AS profile_id,
+    sp.tenant_id,
+    sp.profile_name,
+    sp.timezone,
+    sp.conflict_resolution,
+    array_agg(pc.calendar_id) AS calendar_ids,
+    array_agg(pc.weight) AS weights
+   FROM (calendar.active_profiles sp
