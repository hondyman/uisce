+--
+-- Name: sync_validation_rules_to_catalog(); Type: FUNCTION; Schema: public; Owner: -
+--
+
+CREATE FUNCTION public.sync_validation_rules_to_catalog() RETURNS trigger
+    LANGUAGE plpgsql
+    AS $$
+    DECLARE
+      new_json jsonb;
+      rule_type text;
+      desc_text text;
+      rule_category text;
+      rule_description text;
+      field_path text;
+      condition_json jsonb;
+      exec_client boolean;
+      exec_server boolean;
+      r_blur boolean;
+      r_change boolean;
+      r_submit boolean;
+      -- target entity resolution
+      target_entity_text text;
+      target_entity_id_text text;
+    BEGIN
+      -- Initialize from NEW inside BEGIN (NEW isn't allowed in DECLARE initializers)
+      new_json := to_jsonb(NEW);
+      rule_type := COALESCE(new_json->> 'rule_category', new_json->> 'rule_type', 'business_logic');
+      desc_text := COALESCE(new_json->> 'rule_description', new_json->> 'description');
+      rule_category := COALESCE(new_json->> 'rule_category', new_json->> 'rule_type');
+      rule_description := COALESCE(new_json->> 'rule_description', new_json->> 'description');
+      field_path := new_json->> 'field_path';
+      -- resolve target entity name and id (if available)
+      target_entity_text := new_json->> 'target_entity';
+      SELECT cn.id INTO target_entity_id_text FROM public.catalog_node cn JOIN public.catalog_node_type cnt ON cnt.id = cn.node_type_id WHERE cnt.catalog_type_name IN ('semantic_column','semantic_term') AND cn.node_name = target_entity_text LIMIT 1;
+      condition_json := COALESCE(new_json->'condition_json', NULL::jsonb);
+      exec_client := COALESCE((new_json->> 'execute_client_side')::boolean, false);
+      exec_server := COALESCE((new_json->> 'execute_server_side')::boolean, true);
+      r_blur := COALESCE((new_json->> 'run_on_blur')::boolean, false);
+      r_change := COALESCE((new_json->> 'run_on_change')::boolean, false);
+      r_submit := COALESCE((new_json->> 'run_on_submit')::boolean, true);
+
+      IF (TG_OP = 'INSERT' OR TG_OP = 'UPDATE') THEN
+        INSERT INTO public.catalog_validation_rules (
+          id, tenant_id, rule_name, rule_type, description, rule_category, rule_description, target_entity, target_entity_id, condition_json, severity, is_active, created_by, created_at, updated_at, field_path, execute_client_side, execute_server_side, run_on_blur, run_on_change, run_on_submit, source
+        ) VALUES (
+          NEW.id, NEW.tenant_id, NEW.rule_name, rule_type, desc_text, rule_category, rule_description, target_entity_text, target_entity_id_text, condition_json, COALESCE((new_json->> 'severity')::text, 'error'), COALESCE((new_json->> 'is_active')::boolean, true), NEW.created_by, NEW.created_at, NEW.updated_at, field_path, exec_client, exec_server, r_blur, r_change, r_submit, 'bo'
+        )
+        ON CONFLICT (id) DO UPDATE SET
+          tenant_id = EXCLUDED.tenant_id,
+          rule_name = EXCLUDED.rule_name,
+          rule_type = EXCLUDED.rule_type,
+          description = EXCLUDED.description,
+          rule_category = EXCLUDED.rule_category,
+          rule_description = EXCLUDED.rule_description,
+          target_entity = EXCLUDED.target_entity,
+          target_entity_id = COALESCE(EXCLUDED.target_entity_id, public.catalog_validation_rules.target_entity_id),
+          condition_json = EXCLUDED.condition_json,
+          severity = EXCLUDED.severity,
+          is_active = EXCLUDED.is_active,
+          created_by = COALESCE(EXCLUDED.created_by, public.catalog_validation_rules.created_by),
+          created_at = COALESCE(EXCLUDED.created_at, public.catalog_validation_rules.created_at),
+          updated_at = EXCLUDED.updated_at,
+          field_path = EXCLUDED.field_path,
+          execute_client_side = EXCLUDED.execute_client_side,
+          execute_server_side = EXCLUDED.execute_server_side,
+          run_on_blur = EXCLUDED.run_on_blur,
+          run_on_change = EXCLUDED.run_on_change,
+          run_on_submit = EXCLUDED.run_on_submit,
+          source = 'bo';
+
+        RETURN NEW;
+      ELSIF (TG_OP = 'DELETE') THEN
+        UPDATE public.catalog_validation_rules SET is_active = false, updated_at = now() WHERE id = OLD.id;
+        RETURN OLD;
+      END IF;
+      RETURN NULL;
+    END;
+    $$;
+
