+--
+-- Name: audit_merge_view; Type: VIEW; Schema: public; Owner: -
+--
+
+CREATE VIEW public.audit_merge_view AS
+ SELECT ae.id,
+    ae."timestamp" AS event_timestamp,
+    ae.event_type,
+    ae.severity,
+    ae.user_id AS actor_id,
+    ae.tenant_id,
+    ae.session_id,
+    ae.resource_id,
+    ae.resource_type,
+    ae.action,
+    ae.ip_address,
+    ae.user_agent,
+    ae.request_id,
+    ae.details,
+    ae.old_values,
+    ae.new_values,
+    ae.success,
+    ae.error_message,
+    ae.compliance_flags,
+    'audit_events'::text AS source_table
+   FROM public.audit_events ae
+UNION ALL
+ SELECT asl.id,
+    asl.created_at AS event_timestamp,
+    'abac_decision'::character varying AS event_type,
+        CASE
+            WHEN (asl.drift_indicator = 'true'::text) THEN 'warn'::text
+            ELSE 'info'::text
+        END AS severity,
+    asl.user_id AS actor_id,
+    asl.tenant_id,
+    NULL::character varying AS session_id,
+    asl.object AS resource_id,
+    'abac_decision'::character varying AS resource_type,
+    asl.operation AS action,
+    NULL::inet AS ip_address,
+    NULL::text AS user_agent,
+    NULL::character varying AS request_id,
+    jsonb_build_object('rbac_decision', asl.rbac_decision, 'abac_decision', asl.abac_decision, 'drift_indicator', asl.drift_indicator, 'mode', asl.mode, 'rules_evaluated', asl.rules_evaluated, 'context_sample', asl.context_sample) AS details,
+    NULL::jsonb AS old_values,
+    NULL::jsonb AS new_values,
+    COALESCE((asl.abac_decision = 'true'::text), false) AS success,
+        CASE
+            WHEN COALESCE((asl.drift_indicator = 'true'::text), false) THEN 'ABAC/RBAC decision mismatch detected'::text
+            ELSE NULL::text
+        END AS error_message,
+    ARRAY[]::text[] AS compliance_flags,
+    'abac_shadow_logs'::text AS source_table
+   FROM public.abac_shadow_logs asl;
+
+
