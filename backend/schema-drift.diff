+CREATE FUNCTION aggregates.cleanup_old_metrics(p_retention_days integer DEFAULT 365) RETURNS integer
+    LANGUAGE plpgsql
+    AS $$
+DECLARE
+    deleted_count INTEGER;
+BEGIN
+    DELETE FROM aggregates.preaggregated_metrics
+    WHERE last_refresh < NOW() - INTERVAL '1 day' * p_retention_days;
 
+    GET DIAGNOSTICS deleted_count = ROW_COUNT;
+    RETURN deleted_count;
+END;
+$$;
 
