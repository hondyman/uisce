+-- Name: add_business_days(character varying, date, integer); Type: FUNCTION; Schema: public; Owner: -
+--
+
+CREATE FUNCTION public.add_business_days(p_calendar_code character varying, p_from_date date, p_days integer) RETURNS date
+    LANGUAGE plpgsql STABLE
+    AS $$
+DECLARE
+    v_current DATE := p_from_date;
+    v_remaining INTEGER := ABS(p_days);
+    v_step INTEGER := CASE WHEN p_days >= 0 THEN 1 ELSE -1 END;
+BEGIN
+    WHILE v_remaining > 0 LOOP
+        v_current := v_current + v_step;
+        IF is_business_day(p_calendar_code, v_current) THEN
+            v_remaining := v_remaining - 1;
+        END IF;
+    END LOOP;
+    RETURN v_current;
+END;
+$$;
+
