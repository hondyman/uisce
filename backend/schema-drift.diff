+--
+-- Name: job_progress_summary; Type: VIEW; Schema: edm; Owner: -
+--
+
+CREATE VIEW edm.job_progress_summary AS
+ SELECT j.id,
+    j.tenant_id,
+    j.operation_type,
+    j.status,
+    j.total_items,
+    j.processed_items,
+    j.succeeded_items,
+    j.failed_items,
+    count(
+        CASE
+            WHEN ((ji.status)::text = 'pending'::text) THEN 1
+            ELSE NULL::integer
+        END) AS pending_items,
+    count(
+        CASE
+            WHEN ((ji.status)::text = 'processing'::text) THEN 1
+            ELSE NULL::integer
+        END) AS processing_items,
+    count(
+        CASE
+            WHEN ((ji.status)::text = 'failed'::text) THEN 1
+            ELSE NULL::integer
+        END) AS item_errors,
+    (round(((100.0 * (j.processed_items)::numeric) / (NULLIF(j.total_items, 0))::numeric)))::integer AS progress_percent,
+    j.created_at,
+    j.started_at,
+    j.completed_at,
+    (EXTRACT(epoch FROM (COALESCE((j.completed_at)::timestamp with time zone, now()) - (j.created_at)::timestamp with time zone)))::integer AS duration_seconds
+   FROM (edm.async_jobs j
+     LEFT JOIN edm.job_items ji ON ((j.id = ji.job_id)))
+  GROUP BY j.id, j.tenant_id, j.operation_type, j.status, j.total_items, j.processed_items, j.succeeded_items, j.failed_items, j.created_at, j.started_at, j.completed_at;
+
