+--
+-- Name: calendar_add_business_days(date, character varying, integer); Type: FUNCTION; Schema: vend; Owner: -
+--
+
+CREATE FUNCTION vend.calendar_add_business_days(p_date date, p_cal character varying, p_days integer) RETURNS date
+    LANGUAGE plpgsql IMMUTABLE
+    AS $$
+DECLARE
+    result_date DATE := COALESCE(p_date, CURRENT_DATE);
+    direction INT := SIGN(p_days);
+    remaining INT := ABS(p_days);
+BEGIN
+    WHILE remaining > 0 LOOP
+        result_date := result_date + direction;
+        IF NOT EXISTS (
+            SELECT 1 FROM public.tenant_calendar_holidays h
+            JOIN public.tenant_exchange_calendars c ON h.calendar_id = c.id
+            WHERE c.calendar_code = p_cal AND h.holiday_date = result_date
+        )
+        AND EXTRACT(DOW FROM result_date) NOT IN (0, 6) THEN
+            remaining := remaining - 1;
+        END IF;
+    END LOOP;
+    RETURN result_date;
+END;
+$$;
+
+
+--
+-- Name: calendar_is_business_day(date, character varying); Type: FUNCTION; Schema: vend; Owner: -
