+-- Name: client_crypto_portfolios; Type: VIEW; Schema: public; Owner: -
+--
+
+CREATE VIEW public.client_crypto_portfolios AS
+ SELECT c.id AS client_id,
+    c.client_name,
+    count(DISTINCT h.asset_symbol) AS unique_assets,
+    COALESCE(sum((h.quantity * COALESCE(p.price_usd, (0)::numeric))), (0)::numeric) AS total_crypto_value,
+    COALESCE((sum((h.quantity * COALESCE(p.price_usd, (0)::numeric))) - sum(h.cost_basis_total)), (0)::numeric) AS total_unrealized_gain_loss,
+    sum(h.cost_basis_total) AS total_cost_basis,
+    max(h.last_updated) AS last_updated
+   FROM (((public.clients c
+     JOIN public.crypto_wallets w ON ((c.id = w.client_id)))
+     JOIN public.crypto_holdings h ON ((w.id = h.wallet_id)))
+     LEFT JOIN public.crypto_latest_prices p ON (((h.asset_symbol)::text = (p.asset_symbol)::text)))
+  GROUP BY c.id, c.client_name;
