+    LANGUAGE plpgsql
+    AS $$
+BEGIN
+    RETURN QUERY
+    SELECT
+        rs.metric_node_id,
+        rs.schedule_expression,
+        rs.next_scheduled_run
+    FROM semantic.refresh_schedules rs
+    WHERE rs.is_active = true
+    ORDER BY rs.next_scheduled_run ASC
+    LIMIT p_limit;
+END;
+$$;
