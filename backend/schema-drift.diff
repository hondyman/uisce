+--
+-- Name: insert_bo_field_with_wiring_v2(uuid, uuid, text, text, text, text); Type: FUNCTION; Schema: public; Owner: -
+--
+
+CREATE FUNCTION public.insert_bo_field_with_wiring_v2(p_tenant_id uuid, p_bo_id uuid, p_field_key text, p_label text, p_type text, p_term_path text) RETURNS void
+    LANGUAGE plpgsql
+    AS $$
+DECLARE
+    v_field_id UUID;
+    v_field_type_id UUID;
+    v_has_field_etype UUID;
+    v_term_node_id UUID;
+    v_maps_to_etype UUID;
+BEGIN
+    SELECT id INTO v_field_type_id FROM public.catalog_node_types WHERE catalog_type_name = 'BO_FIELD_VERSION' LIMIT 1;
+    IF v_field_type_id IS NULL THEN
+        SELECT id INTO v_field_type_id FROM public.catalog_node_types WHERE catalog_type_name = 'catalog_node' LIMIT 1;
+    END IF;
+
+    SELECT id INTO v_has_field_etype FROM public.catalog_edge_types WHERE edge_type_name = 'BO_HAS_FIELD_VERSION' LIMIT 1;
+    SELECT id INTO v_maps_to_etype FROM public.catalog_edge_types WHERE edge_type_name = 'BO_FIELD_MAPS_TO_SEMANTIC_TERM' LIMIT 1;
+    
+    -- 1. Create Field Node (Stable UUID based on BO + Key)
+    v_field_id := md5(p_bo_id::text || p_field_key)::uuid;
+    
+    IF NOT EXISTS (SELECT 1 FROM public.catalog_node WHERE id = v_field_id) THEN
+        INSERT INTO public.catalog_node (id, tenant_id, node_type_id, node_name, properties, qualified_path)
+        VALUES (v_field_id, p_tenant_id, v_field_type_id, p_field_key, jsonb_build_object('label', p_label, 'data_type', p_type), 'gold-copy/bo-fields/' || p_field_key);
+    END IF;
+    
+    -- 2. Link BO -> Field
+    IF v_has_field_etype IS NOT NULL THEN
+        INSERT INTO public.catalog_edge (tenant_id, source_node_id, target_node_id, edge_type_id)
+        SELECT p_tenant_id, p_bo_id, v_field_id, v_has_field_etype
+        WHERE NOT EXISTS (SELECT 1 FROM public.catalog_edge WHERE source_node_id = p_bo_id AND target_node_id = v_field_id AND edge_type_id = v_has_field_etype);
+    END IF;
+    
+    -- 3. Resolve/Link Semantic Term
+    IF p_term_path IS NOT NULL THEN
+        SELECT id INTO v_term_node_id FROM public.catalog_node WHERE qualified_path = p_term_path AND tenant_id = p_tenant_id;
+        
+        IF v_term_node_id IS NOT NULL AND v_maps_to_etype IS NOT NULL THEN
+            INSERT INTO public.catalog_edge (tenant_id, source_node_id, target_node_id, edge_type_id)
+            SELECT p_tenant_id, v_field_id, v_term_node_id, v_maps_to_etype
+            WHERE NOT EXISTS (SELECT 1 FROM public.catalog_edge WHERE source_node_id = v_field_id AND target_node_id = v_term_node_id AND edge_type_id = v_maps_to_etype);
+        END IF;
+    END IF;
+END;
+$$;
+
