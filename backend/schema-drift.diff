+CREATE FUNCTION edm.bp_get_active_delegation(p_delegator_user_id uuid, p_delegate_user_id uuid, p_tenant_id uuid, p_datasource_id uuid, p_resource_type character varying DEFAULT NULL::character varying, p_resource_id uuid DEFAULT NULL::uuid) RETURNS uuid
