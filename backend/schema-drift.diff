+    r.domain,
+        CASE
+            WHEN (r.golden_path = false) THEN 'not_golden'::text
+            WHEN (sv.id IS NOT NULL) THEN 'sla_violation'::text
+            WHEN (mf.meets_sla = false) THEN 'quality_gate_failed'::text
+            WHEN ((now() - mf.last_refresh) > '24:00:00'::interval) THEN 'stale_data'::text
+            ELSE 'ready'::text
+        END AS readiness_status,
+    mf.value AS current_value,
+    mf.as_of_date AS last_data_date,
+    mf.last_refresh,
+    sv.violation_type,
+    sv.status AS violation_status
+   FROM ((semantic.metric_registry r
+     LEFT JOIN public.metrics_finalized mf ON (((r.metric_id = mf.metric_id) AND (mf.id = ( SELECT metrics_finalized.id
+           FROM public.metrics_finalized
+          WHERE (metrics_finalized.metric_id = r.metric_id)
+          ORDER BY metrics_finalized.as_of_date DESC
+         LIMIT 1)))))
+     LEFT JOIN public.sla_violations sv ON (((r.metric_id = sv.metric_id) AND (sv.status = 'open'::text))))
+  WHERE (r.golden_path = true);
+
