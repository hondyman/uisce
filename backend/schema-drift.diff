+--
+-- Name: audit_summary_by_hour; Type: MATERIALIZED VIEW; Schema: public; Owner: -
+--
+
+CREATE MATERIALIZED VIEW public.audit_summary_by_hour AS
+ SELECT tenant_id,
+    date_trunc('hour'::text, event_timestamp) AS hour,
+    event_type,
+    severity,
+    count(*) AS count,
+    sum(
+        CASE
+            WHEN (success IS TRUE) THEN 1
+            ELSE 0
+        END) AS success_count,
+    sum(
+        CASE
+            WHEN (success IS FALSE) THEN 1
+            ELSE 0
+        END) AS failure_count
+   FROM public.audit_merge_view
+  GROUP BY tenant_id, (date_trunc('hour'::text, event_timestamp)), event_type, severity
+  WITH NO DATA;
+
